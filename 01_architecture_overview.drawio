        </mxCell>
        <mxCell id="edge_3" value="3. EventSource SSE Connect&#10;GET /api/v1/observability/logs/stream&#10;Accept: text/event-stream | x-request-id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2.5;fontColor=#0f766e;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_client_net" target="cms_sse">
          <mxGeometry relative="1" as="geometry">
