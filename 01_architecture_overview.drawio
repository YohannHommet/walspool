              <mxPoint x="200" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_client_int_2" value="computed(logs) réactif" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_store" target="card_spa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="515" />
              <mxPoint x="200" y="500" />
