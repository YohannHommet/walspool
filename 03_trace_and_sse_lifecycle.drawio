  <diagram id="trace_and_sse_lifecycle" name="Flux de Données &amp; Cycle de Vie d'une Requête">
    <mxGraphModel dx="1720" dy="2650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="2650" math="0" shadow="0">
