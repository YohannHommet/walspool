<mxCell id="e10_enqueue" value="&lt;b style=&quot;font-size:12px;&quot;&gt;10.2. Émission log Gateway : POST http://localhost:9099/v1/enqueue&lt;/b&gt;&lt;br&gt;Payload: {&quot;topic&quot;: &quot;core.gateway.logs&quot;, &quot;payload&quot;: { &quot;service&quot;: &quot;api-gateway&quot;, &quot;trace_id&quot;: &quot;c4a2e881...&quot;, &quot;duration_ms&quot;: 210, &quot;status_code&quot;: 200, &quot;method&quot;: &quot;POST&quot;, &quot;path&quot;: &quot;/api/v1/ai/generate&quot; }}" style="endArrow=block;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
