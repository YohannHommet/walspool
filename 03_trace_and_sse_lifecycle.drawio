    </mxCell>
<mxCell id="p1_bg" value="&lt;b style=&quot;font-size:13px; color:#37474f;&quot;&gt;PHASE 1 : ÉTABLISSEMENT DU CANAL SSE PERSISTANT &amp;amp; MÉCANISME DE KEEPALIVE (Console Platform ↔ Walspool)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#90a4ae;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="180" width="1640" height="270" as="geometry" />
    </mxCell>
<mxCell id="e1_1" value="&lt;b&gt;1.1. Inscription au flux de logs en direct : GET /api/v1/observability/logs/stream&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Headers: Accept: text/event-stream | Cache-Control: no-cache | (EventSource factory)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1550" y="225" as="sourcePoint" />
        <mxPoint x="510" y="225" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e1_2" value="&lt;b&gt;1.2. Relais proxy SSE : GET /v1/logs/stream&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Proxy Node.js non-bufferisé (ObservabilityController.getLogsStream)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="510" y="265" as="sourcePoint" />
        <mxPoint x="1210" y="265" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e1_3a" value="&lt;b&gt;1.3. Headers HTTP 200 + Flush immédiat + Événement initial : &lt;font color=&quot;#2e7d32&quot;&gt;&quot;: connected\n\n&quot;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Headers: Content-Type: text/event-stream | X-Accel-Buffering: no | Connection: keep-alive&lt;/font&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1210" y="310" as="sourcePoint" />
        <mxPoint x="510" y="310" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e1_3b" value="&lt;b&gt;1.3 (suite). Relais direct (upstreamRes.pipe(res)) ➔ Console connectée&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="510" y="310" as="sourcePoint" />
        <mxPoint x="1550" y="310" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e1_4a" value="&lt;b&gt;1.4. Heartbeat périodique (ticker Go 10s) : &lt;font color=&quot;#d79b00&quot;&gt;&quot;: keepalive\n\n&quot;&lt;/font&gt;&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1210" y="355" as="sourcePoint" />
        <mxPoint x="510" y="355" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e1_4b" value="&lt;b&gt;Keepalive relayé vers Console (maintien connexion TCP active)&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="510" y="355" as="sourcePoint" />
        <mxPoint x="1550" y="355" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="n1" value="&lt;b style=&quot;color:#bf360c;&quot;&gt;Contrat de Résilience SSE &amp;amp; Anti-Buffering :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;X-Accel-Buffering: no&lt;/b&gt; interdit aux proxies intermédiaires (NGINX, Envoy, Traefik) d&#39;accumuler les buffers de streaming.&lt;br&gt;• Le ticker interne Walspool émet un commentaire SSE &lt;i&gt;(&quot;: keepalive\n\n&quot;)&lt;/i&gt; toutes les 10s, empêchant les timeouts de passerelle.&lt;br&gt;• En cas de coupure réseau, le store Vue 3 reconnecte automatiquement le flux avec backoff exponentiel &amp;amp; background sync." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#fff8e1;strokeColor=#ffe082;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="630" y="380" width="790" height="60" as="geometry" />
    </mxCell>
<mxCell id="p2_bg" value="&lt;b style=&quot;font-size:13px; color:#4a148c;&quot;&gt;PHASE 2 : INGESTION MÉTIER &amp;amp; PROPAGATION UNIFIÉE DU CONTEXTE (AsyncLocalStorage ↔ contextvars)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf7ff;strokeColor=#ba68c8;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="470" width="1640" height="440" as="geometry" />
    </mxCell>
<mxCell id="e2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;2. Requête Métier : POST /api/v1/ai/generate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Payload: {&quot;prompt&quot;: &quot;Analyser les données de télémétrie du cluster...&quot;} (aucun x-request-id présent)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#1e88e5;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="180" y="515" as="sourcePoint" />
        <mxPoint x="505" y="515" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e3_loop" value="&lt;b&gt;3. TraceMiddleware (LoopBack 4)&lt;/b&gt;&lt;br&gt;Vérifie / génère UUID v4&lt;br&gt;Initialise AsyncLocalStorage" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="515" y="535" as="sourcePoint" />
        <mxPoint x="515" y="605" as="targetPoint" />
        <Array as="points">
          <mxPoint x="590" y="535" />
          <mxPoint x="590" y="605" />
        </Array>
      </mxGeometry>
    </mxCell>
<mxCell id="n3" value="&lt;b style=&quot;color:#4a148c;&quot;&gt;Détails Interception TraceMiddleware (Node.js) :&lt;/b&gt;&lt;br&gt;1. Recherche en-têtes : &lt;i&gt;x-request-id&lt;/i&gt;, &lt;i&gt;x-correlation-id&lt;/i&gt;, &lt;i&gt;x-trace-id&lt;/i&gt;.&lt;br&gt;2. Génère un UUID v4 unique : &lt;b style=&quot;color:#1e88e5;&quot;&gt;trace_id = &quot;c4a2e881-3b71-48f9-902e-1d5e3170a821&quot;&lt;/b&gt;.&lt;br&gt;3. Injection précoce dans la réponse : &lt;i&gt;res.setHeader(&#39;x-request-id&#39;, traceId)&lt;/i&gt;.&lt;br&gt;4. Exécute la chaîne d&#39;intercepteurs dans &lt;b&gt;traceStorage.run({ traceId, startTime: Date.now(), ... })&lt;/b&gt; via &lt;b&gt;AsyncLocalStorage&lt;/b&gt; (isolation totale sans variables globales).&lt;br&gt;5. Mémorise &lt;i&gt;startTime&lt;/i&gt; pour le calcul de durée aval." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#f3e5f5;strokeColor=#ce93d8;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="230" y="540" width="265" height="150" as="geometry" />
    </mxCell>
<mxCell id="e4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;4. Propagation HTTP vers service aval : POST http://aipi:8000/api/v1/inference&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1e88e5&quot;&gt;&lt;b&gt;Headers injectés: [x-request-id: c4a2e881-3b71-48f9-902e-1d5e3170a821]&lt;/b&gt;&lt;/font&gt; | Content-Type: application/json" style="endArrow=block;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="515" y="685" as="sourcePoint" />
        <mxPoint x="855" y="685" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e5_loop" value="&lt;b&gt;5. TraceMiddleware Django&lt;/b&gt;&lt;br&gt;Extrait header x-request-id&lt;br&gt;Stocke dans contextvars" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="865" y="705" as="sourcePoint" />
        <mxPoint x="865" y="775" as="targetPoint" />
        <Array as="points">
          <mxPoint x="945" y="705" />
          <mxPoint x="945" y="775" />
        </Array>
      </mxGeometry>
    </mxCell>
<mxCell id="n5" value="&lt;b style=&quot;color:#2e7d32;&quot;&gt;Détails Middleware AIPI (Python / Django) :&lt;/b&gt;&lt;br&gt;1. Récupère l&#39;en-tête &lt;i&gt;request.headers.get(&#39;x-request-id&#39;)&lt;/i&gt;.&lt;br&gt;2. Initialise la variable de contexte thread-safe / async-safe :&lt;br&gt;   &lt;b&gt;token = request_trace_id.set(trace_id)&lt;/b&gt; (&lt;i&gt;ContextVar[Optional[str]]&lt;/i&gt;).&lt;br&gt;3. Associe &lt;i&gt;request.trace_id = trace_id&lt;/i&gt; pour l&#39;accès direct dans les vues.&lt;br&gt;4. Bloc strict &lt;b&gt;finally: reset_current_trace_id(token)&lt;/b&gt; garantissant l&#39;absence totale de fuite de contexte entre requêtes réutilisant le même thread WSGI/ASGI." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#e8f5e9;strokeColor=#a5d6a7;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="960" y="710" width="370" height="135" as="geometry" />
    </mxCell>
<mxCell id="b2" value="&lt;b&gt;✔ Garantie Corrélation Distribuée :&lt;/b&gt; Le Trace ID &lt;b style=&quot;color:#1e88e5;&quot;&gt;c4a2e881-3b71-48f9-902e-1d5e3170a821&lt;/b&gt; est désormais lié de manière transparente et asynchrone aux contextes d&#39;exécution Node.js (V8) et Python (CPython), prêt pour toute journalisation sans passage explicite de paramètres." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a148c;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="250" y="855" width="1280" height="40" as="geometry" />
    </mxCell>
<mxCell id="p3_bg" value="&lt;b style=&quot;font-size:13px; color:#1b5e20;&quot;&gt;PHASE 3 : TÉLÉMÉTRIE ASYNCHRONE NON-BLOQUANTE &amp;amp; DIFFUSION TEMPS RÉEL (AIPI ➔ Walspool ➔ Vue 3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#81c784;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="930" width="1640" height="520" as="geometry" />
    </mxCell>
<mxCell id="e6_1" value="&lt;b&gt;6.1. Exécution Inférence : logger.info(&quot;Démarrage inférence IA&quot;, extra={&quot;model&quot;: &quot;llama-3-8b&quot;, &quot;tokens&quot;: 512})&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="865" y="965" as="sourcePoint" />
        <mxPoint x="865" y="1015" as="targetPoint" />
        <Array as="points">
          <mxPoint x="930" y="965" />
          <mxPoint x="930" y="1015" />
        </Array>
      </mxGeometry>
    </mxCell>
<mxCell id="n6" value="&lt;b style=&quot;color:#e65100;&quot;&gt;6.2. WalspoolHandler.emit() (Arrière-plan Non-Bloquant) :&lt;/b&gt;&lt;br&gt;• Récupère automatiquement le &lt;b&gt;trace_id&lt;/b&gt; actif via &lt;i&gt;get_current_trace_id()&lt;/i&gt; depuis &lt;i&gt;contextvars&lt;/i&gt;.&lt;br&gt;• Formate le payload selon le schéma &lt;b&gt;StandardLogEvent&lt;/b&gt; (timestamp ISO UTC, service: &quot;aipi&quot;, context, extra).&lt;br&gt;• Enfile l&#39;événement sans attendre : &lt;b&gt;_queue.put_nowait(event)&lt;/b&gt; (file bornée max 5000 items).&lt;br&gt;• &lt;b&gt;Isolation Black-Box :&lt;/b&gt; Le thread de calcul IA n&#39;attend JAMAIS le réseau. Si Walspool est éteint ou saturé, le log est droppé sans lever d&#39;exception métier." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#fff3e0;strokeColor=#ffb74d;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="450" y="990" width="395" height="120" as="geometry" />
    </mxCell>
<mxCell id="e6_3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;6.3. Thread Daemon (WalspoolLogWorker) : POST http://localhost:9099/v1/enqueue&lt;/b&gt;&lt;br&gt;Payload: {&quot;topic&quot;: &quot;core.aipi.logs&quot;, &quot;payload&quot;: { &quot;service&quot;: &quot;aipi&quot;, &quot;trace_id&quot;: &quot;c4a2e881...&quot;, &quot;level&quot;: &quot;INFO&quot;, &quot;message&quot;: &quot;Démarrage inférence IA&quot; }}" style="endArrow=block;html=1;strokeColor=#e65100;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="865" y="1080" as="sourcePoint" />
        <mxPoint x="1210" y="1080" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e6_4" value="&lt;b&gt;6.4. HTTP 202 Accepted {&quot;status&quot;: &quot;accepted&quot;, &quot;topic&quot;: &quot;core.aipi.logs&quot;, &quot;size_bytes&quot;: 312}&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1210" y="1115" as="sourcePoint" />
        <mxPoint x="865" y="1115" as="targetPoint" />
      </mxGeometry>
    </mxCell>
<mxCell id="e7_loop" value="&lt;b&gt;7.1. Moteur Walspool (Go)&lt;/b&gt;&lt;br&gt;• Append WAL disque (fsync &amp;amp; CRC32)&lt;br&gt;• Index circulaire MemoryLogHub&lt;br&gt;• Broadcast immédiat canal logCh" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="1215" y="1135" as="sourcePoint" />
        <mxPoint x="1215" y="1205" as="targetPoint" />
        <Array as="points">
          <mxPoint x="1300" y="1135" />
          <mxPoint x="1300" y="1205" />
        </Array>
      </mxGeometry>
    </mxCell>
<mxCell id="e7_push_gw" value="&lt;b style=&quot;font-size:12px;&quot;&gt;7.2. Push SSE temps réel (Flux actif) : data: {&quot;timestamp&quot;:&quot;...&quot;,&quot;service&quot;:&quot;aipi&quot;,&quot;trace_id&quot;:&quot;c4a2e881...&quot;,&quot;level&quot;:&quot;INFO&quot;,&quot;message&quot;:&quot;Démarrage inférence IA&quot;}\n\n&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#0288d1;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
