<mxCell id="n8" value="&lt;b style=&quot;color:#0277bd;&quot;&gt;Détails Normalisation &amp;amp; Réactivité Vue 3 (useObservabilityStore) :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;normalizeLogEvent(raw) :&lt;/b&gt; Uniformise les champs hétérogènes (timestamp UTC, level normalisé en minuscule, ID unique déterministe ou aléatoire, extraction payload/extra).&lt;br&gt;• &lt;b&gt;addLog(log) :&lt;/b&gt; Dédoublonne par &lt;i&gt;log.id&lt;/i&gt;, respecte le buffer tournant &lt;i&gt;maxBufferSize&lt;/i&gt; (500 logs) et déclenche la réactivité Pinia / Vue 3.&lt;br&gt;• &lt;b&gt;Affichage direct :&lt;/b&gt; L&#39;événement AIPI apparaît en temps réel dans le tableau sans rafraîchissement ni polling !" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#e1f5fe;strokeColor=#81d4fa;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
      <mxGeometry x="1170" y="1325" width="480" height="110" as="geometry" />
    </mxCell>
<mxCell id="p4_bg" value="&lt;b style=&quot;font-size:13px; color:#006064;&quot;&gt;PHASE 4 : COMPLÉTION DE L&#39;INFÉRENCE, CALCUL DE LATENCE &amp;amp; CORRÉLATION WATERFALL GANTT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#4dd0e1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
