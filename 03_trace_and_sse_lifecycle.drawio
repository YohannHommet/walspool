<mxCell id="e8_loop" value="&lt;b&gt;8. Réception Vue 3 &amp;amp; Pinia Store&lt;/b&gt;&lt;br&gt;onmessage ➔ normalizeLogEvent()&lt;br&gt;addLog() ➔ logs.value réactif" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
