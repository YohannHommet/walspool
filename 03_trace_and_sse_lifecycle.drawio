<mxCell id="banner" value="&lt;b style=&quot;font-size:18px;&quot;&gt;FLUX DE DONNÉES &amp;amp; CYCLE DE VIE D&#39;UNE REQUÊTE : TRAÇABILITÉ DISTRIBUÉE &amp;amp; STREAMING SSE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px; color:#546e7a;&quot;&gt;Corrélation de bout en bout via &lt;b style=&quot;color:#1e88e5;&quot;&gt;x-request-id&lt;/b&gt; • Propagation asynchrone (AsyncLocalStorage / contextvars) • Télémétrie non-bloquante Walspool &amp;amp; Cascade Waterfall Gantt&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="40" y="15" width="1640" height="65" as="geometry" />
    </mxCell>
<mxCell id="p1_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Client Métier&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;Navigateur / Frontend Utilisateur&lt;br&gt;&lt;i&gt;Appel API &amp;amp; Consommation IA&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
