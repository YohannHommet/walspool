<mxCell id="e9_3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;9.3. Réponse finale au client : HTTP/1.1 200 OK&lt;/b&gt;&lt;br&gt;Headers: [x-request-id: c4a2e881-3b71-48f9-902e-1d5e3170a821] | Body: {&quot;result&quot;: &quot;Analyse complétée avec succès...&quot;}" style="endArrow=block;dashed=1;html=1;strokeColor=#1e88e5;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
