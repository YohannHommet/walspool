        <mxCell id="badge_trace" value="Traçabilité distribuée de bout en bout : en-tête x-request-id (UUIDv4) propagé sur tous les sauts réseau" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontSize=10;fontColor=#cbd5e1;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="1105" y="58" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="zone_client" value="ESPACE CLIENT WEB (NAVIGATEUR)&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#b45309;&quot;&gt;Application Single Page (SPA) Platform sous Vue 3 &amp;amp; TypeScript&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;dashed=1;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=12;fontStyle=1;fontSize=13;fontColor=#92400e;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="320" height="830" as="geometry" />
        </mxCell>
        <mxCell id="card_browser" value="&lt;b&gt;Navigateur Web (Poste Client)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fcd34d;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;URL :&lt;/b&gt; &lt;code style=&quot;color:#b45309;font-size:9px;&quot;&gt;https://test.ignimission.inside/platform/observability&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Moteur :&lt;/b&gt; Chromium / Firefox / WebKit&lt;br/&gt;&lt;b&gt;Protocole externe :&lt;/b&gt; HTTPS / TLS 1.3 (HTTP/2)&lt;br/&gt;&lt;b&gt;En-têtes émis :&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;Accept: text/event-stream&lt;/code&gt; (Flux SSE)&lt;br/&gt;• &lt;code&gt;x-request-id: &amp;lt;uuid&amp;gt;&lt;/code&gt; (Trace context)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=8;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="165" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="card_spa" value="&lt;b&gt;Module Observabilité Platform (Vue 3)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fcd34d;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;Package :&lt;/b&gt; &lt;code&gt;@ignimission/platform&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Composants UI interactifs :&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;LiveLogViewer :&lt;/b&gt; Défilement fluide, pause, recherche texte&lt;br/&gt;• &lt;b&gt;TraceInspector :&lt;/b&gt; Arbre des spans reliés par &lt;code&gt;trace_id&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;FilterBar :&lt;/b&gt; Sélecteurs dynamiques de service (&lt;code&gt;aipi&lt;/code&gt;, &lt;code&gt;api-gateway&lt;/code&gt;) &amp;amp; sévérité (&lt;code&gt;INFO&lt;/code&gt;, &lt;code&gt;WARN&lt;/code&gt;, &lt;code&gt;ERROR&lt;/code&gt;)&lt;br/&gt;• &lt;b&gt;Virtual Scroller :&lt;/b&gt; Rendu plafonné pour préserver le CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=8;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="325" width="290" height="175" as="geometry" />
        </mxCell>
        <mxCell id="card_store" value="&lt;b&gt;Store Pinia : useObservabilityStore&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fcd34d;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;Gestion d'état réactive :&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;logs[]&lt;/code&gt; : Buffer circulaire actif (max 500 logs DOM)&lt;br/&gt;• &lt;code&gt;pausedLogsQueue[]&lt;/code&gt; : Rétention en pause manuelle&lt;br/&gt;• &lt;code&gt;connectionStatus&lt;/code&gt; : &lt;code&gt;connecting|connected|paused&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Auto-reconnexion :&lt;/b&gt; Timer avec backoff exponentiel&lt;br/&gt;• &lt;b&gt;Détection Keepalive :&lt;/b&gt; Surveillance de trame heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=8;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="290" height="185" as="geometry" />
        </mxCell>
        <mxCell id="card_client_net" value="&lt;b&gt;Clients Réseau Navigateur&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fcd34d;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;1. W3C EventSource (Streaming SSE) :&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;new EventSource('/api/v1/observability/logs/stream')&lt;/code&gt;&lt;br/&gt;• Connexion semi-duplex maintenue ouverte&lt;br/&gt;• Événements &lt;code&gt;onmessage&lt;/code&gt; parsés en &lt;code&gt;StandardLogEvent&lt;/code&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Fetch API (Requêtes REST unitaires) :&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;GET /api/v1/observability/logs?trace_id=...&lt;/code&gt;&lt;br/&gt;• Récupération d'historique et inspection de traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=12;spacingRight=8;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="715" width="290" height="205" as="geometry" />
        </mxCell>
        <mxCell id="zone_docker" value="RÉSEAU DOCKER BRIDGE : backend (172.99.0.0/24)&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#475569;&quot;&gt;Passerelle Hôte Linux : 172.99.0.1 | Résolution DNS interne Docker (embedded service discovery)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;dashed=1;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=12;fontStyle=1;fontSize=13;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="760" height="830" as="geometry" />
        </mxCell>
        <mxCell id="box_cms" value="Conteneur : docker-cms-1&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#0284c7;&quot;&gt;Nginx 1.25+ Reverse Proxy &amp;amp; Gateway Ingress&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=2;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=12;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="395" y="165" width="350" height="340" as="geometry" />
        </mxCell>
        <mxCell id="badge_cms_ports" value="Host: 80/443 &amp;rarr; Conteneur: 8080/8443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284c7;strokeColor=#0369a1;fontSize=9;fontColor=#ffffff;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="470" y="202" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cms_ssl" value="&lt;b&gt;Terminaison SSL &amp;amp; VirtualHost&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;server_name test.ignimission.inside;&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;ssl_certificate /ii/ssl/fullchain.pem;&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;ssl_certificate_key /ii/ssl/privkey.pem;&lt;/code&gt;&lt;br/&gt;• Redirection HTTP &amp;rarr; HTTPS stricte (301)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="228" width="320" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cms_platform" value="&lt;b&gt;Route /platform/ (Fichiers Statiques SPA)&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;location /platform { alias /var/www/frontend/apps/platform/dist; }&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;try_files $uri $uri/ @platform;&lt;/code&gt; (HTML5 History fallback)&lt;br/&gt;• Sert les bundles compilés Vite/Vue 3 directement au navigateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="310" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cms_sse" value="&lt;b&gt;Route /api/ &amp;amp; Débuffering SSE Critique&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;proxy_pass https://api-gateway:8443/api/;&lt;/code&gt;&lt;br/&gt;• &lt;b style=&quot;color:#b91c1c;&quot;&gt;proxy_buffering off;&lt;/b&gt; (Transmission temps réel immédiate)&lt;br/&gt;• &lt;b style=&quot;color:#b91c1c;&quot;&gt;add_header X-Accel-Buffering &amp;quot;no&amp;quot;;&lt;/b&gt; (Bypass buffer Nginx)&lt;br/&gt;• &lt;code&gt;proxy_set_header X-Forwarded-Ssl on; Host $host;&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="397" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="box_gateway" value="Conteneur : docker-api-gateway-1&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#0d9488;&quot;&gt;Node.js / LoopBack 4 API Gateway&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=2;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=12;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="765" y="165" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="badge_gw_ports" value="HTTPS : 8443 | HTTP : 3004 | SSE : 3005" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d9488;strokeColor=#0f766e;fontSize=9;fontColor=#ffffff;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="845" y="202" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gw_ctrl" value="&lt;b&gt;ObservabilityController (@loopback/rest)&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;GET /api/v1/observability/logs&lt;/code&gt; (Requêtes REST unitaires)&lt;br/&gt;• &lt;code&gt;GET /api/v1/observability/logs/stream&lt;/code&gt; (Abonnement SSE)&lt;br/&gt;• Injection &amp;amp; propagation stricte de l'en-tête &lt;code&gt;x-request-id&lt;/code&gt;&lt;br/&gt;• Cible dynamique configurée par &lt;code&gt;URL_SRV_WALSPOOL&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0d9488;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="228" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gw_sse_pipe" value="&lt;b&gt;SSE Proxy Pipeline (Streaming Continu)&lt;/b&gt;&lt;br/&gt;• Relais continu vers Hôte : &lt;code&gt;http://172.99.0.1:9099/v1/logs/stream&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;Content-Type: text/event-stream; charset=utf-8&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;Cache-Control: no-cache, no-transform&lt;/code&gt; | &lt;code&gt;Connection: keep-alive&lt;/code&gt;&lt;br/&gt;• &lt;b style=&quot;color:#0f766e;&quot;&gt;upstreamRes.pipe(res)&lt;/b&gt; (Transfert sans buffering mémoire)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0d9488;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="315" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gw_logger" value="&lt;b&gt;GatewayLogger (Observabilité Interne)&lt;/b&gt;&lt;br/&gt;• Détection conteneur : &lt;code&gt;/.dockerenv &amp;rarr; http://172.99.0.1:9099&lt;/code&gt;&lt;br/&gt;• Journalise les accès et erreurs Gateway via &lt;code&gt;POST /v1/enqueue&lt;/code&gt;&lt;br/&gt;• Format conforme à &lt;code&gt;StandardLogEvent&lt;/code&gt; (service: api-gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0d9488;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="412" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="box_aipi" value="Conteneur : docker-aipi-1&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#7c3aed;&quot;&gt;Microservice IA Python 3.12 / Django &amp;amp; Inférence LLM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=2;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=12;fontColor=#5b21b6;" vertex="1" parent="1">
          <mxGeometry x="395" y="520" width="730" height="405" as="geometry" />
        </mxCell>
        <mxCell id="badge_aipi_ports" value="Port Interne : 3006 (HTTPS runserver_plus) | Process Supervisord" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=#5b21b6;fontSize=9;fontColor=#ffffff;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="615" y="555" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="aipi_app" value="&lt;b&gt;Application Django IA &amp;amp; RAG&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ddd6fe;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;Modules &amp;amp; Services :&lt;/b&gt;&lt;br/&gt;• Traitement NLP, RAG &amp;amp; Embeddings&lt;br/&gt;• Workers asynchrones Supervisord :&lt;br/&gt;  - &lt;code&gt;aipi-rag-operations-ingest&lt;/code&gt;&lt;br/&gt;  - &lt;code&gt;aipi-rag-operations-update&lt;/code&gt;&lt;br/&gt;• Contexte de corrélation &lt;code&gt;trace_id&lt;/code&gt;&lt;br/&gt;• Émission logs applicatifs standards :&lt;br/&gt;  &lt;code&gt;logger = logging.getLogger('aipi')&lt;/code&gt;&lt;br/&gt;  &lt;code&gt;logger.info('Inference completed')&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="585" width="220" height="325" as="geometry" />
        </mxCell>
        <mxCell id="aipi_handler" value="&lt;b&gt;WalspoolHandler (logging.Handler)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ddd6fe;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;Gestionnaire de logs non-bloquant :&lt;/b&gt;&lt;br/&gt;• Déclaré dans &lt;code&gt;settings.py:LOGGING&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Schéma StandardLogEvent :&lt;/b&gt;&lt;br/&gt;  - &lt;code&gt;timestamp: ISO-8601 UTC&lt;/code&gt;&lt;br/&gt;  - &lt;code&gt;service: 'aipi'&lt;/code&gt;&lt;br/&gt;  - &lt;code&gt;trace_id: &amp;lt;uuid&amp;gt;&lt;/code&gt; (issu de &lt;code&gt;x-request-id&lt;/code&gt;)&lt;br/&gt;  - &lt;code&gt;level: 'INFO'|'WARN'|'ERROR'&lt;/code&gt;&lt;br/&gt;  - &lt;code&gt;payload: { prompt, latency, ... }&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Queue interne bornée :&lt;/b&gt;&lt;br/&gt;  &lt;code&gt;queue.Queue(maxsize=5000)&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Sécurité :&lt;/b&gt; Drop contrôlé si saturation pour préserver la mémoire vive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="645" y="585" width="235" height="325" as="geometry" />
        </mxCell>
        <mxCell id="aipi_worker" value="&lt;b&gt;WalspoolLogWorker (Thread Démon)&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ddd6fe;margin:4px 0 8px 0;&quot;/&gt;&lt;b&gt;Worker d'arrière-plan asynchrone :&lt;/b&gt;&lt;br/&gt;• Thread dédié &lt;code&gt;WalspoolLogWorker&lt;/code&gt;&lt;br/&gt;• Déqueue en continu les logs de la file&lt;br/&gt;• &lt;b&gt;Envoi HTTP POST non-bloquant :&lt;/b&gt;&lt;br/&gt;  &lt;code style=&quot;color:#7c3aed;font-weight:bold;&quot;&gt;http://172.99.0.1:9099/v1/enqueue&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;Tolérance aux pannes (Failsafe) :&lt;/b&gt;&lt;br/&gt;  Si Walspool est éteint ou inaccessible, aucun impact sur l'API IA&lt;br/&gt;• Timeout HTTP strict : 2.0 secondes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=8;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="895" y="585" width="215" height="325" as="geometry" />
        </mxCell>
        <mxCell id="zone_host" value="MACHINE HÔTE LINUX (HOST SYSTEM)&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#047857;&quot;&gt;Passerelle Docker : 172.99.0.1 | Démon natif Go Walspool Sidecar &amp;amp; Persistance NVMe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;dashed=1;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=12;fontStyle=1;fontSize=13;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="520" height="830" as="geometry" />
        </mxCell>
        <mxCell id="box_walspool" value="Démon Walspool Sidecar (Processus Natif Go)&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#059669;&quot;&gt;Écoute HTTP &amp;amp; SSE : 172.99.0.1:9099 | Sub-microsecond In-Process Engine&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=2;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=12;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="1175" y="165" width="490" height="340" as="geometry" />
        </mxCell>
        <mxCell id="badge_walspool_ports" value="Port d'écoute : 172.99.0.1:9099 | Binaire autonome Go 1.25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;fontSize=9;fontColor=#ffffff;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="1295" y="202" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="walspool_http" value="&lt;b&gt;Serveur HTTP &amp;amp; Routeur d'API (:9099)&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;POST /v1/enqueue&lt;/code&gt; : Ingestion ultra-rapide (1.5 µs) &amp;amp; transmission LogHub&lt;br/&gt;• &lt;code&gt;GET  /v1/logs&lt;/code&gt; : Recherche filtrée (&lt;code&gt;trace_id&lt;/code&gt;, &lt;code&gt;service&lt;/code&gt;, &lt;code&gt;level&lt;/code&gt;, &lt;code&gt;limit&lt;/code&gt;)&lt;br/&gt;• &lt;code&gt;GET  /healthz&lt;/code&gt; : Sonde de vivacité | &lt;code&gt;GET /v1/logs/stats&lt;/code&gt; | &lt;code&gt;POST /flush&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="228" width="460" height="75" as="geometry" />
        </mxCell>
        <mxCell id="walspool_hub" value="&lt;b&gt;LogHub In-Memory Ring Buffer (Index Circulaire)&lt;/b&gt;&lt;br/&gt;• Capacité en mémoire vive : 50,000 enregistrements récents&lt;br/&gt;• Indexation temps réel O(1) par &lt;code&gt;trace_id&lt;/code&gt;, &lt;code&gt;service&lt;/code&gt;, &lt;code&gt;severity&lt;/code&gt;&lt;br/&gt;• Distribution Pub/Sub sans verrouillage lourd vers tous les abonnés SSE actifs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="310" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="walspool_sse" value="&lt;b&gt;Moteur de Diffusion SSE (/v1/logs/stream)&lt;/b&gt;&lt;br/&gt;• Souscription dynamique avec filtrage à chaud par service et sévérité&lt;br/&gt;• &lt;b style=&quot;color:#047857;&quot;&gt;Heartbeat automatique toutes les 10s :&lt;/b&gt; &lt;code&gt;: keepalive&#10;&#10;&lt;/code&gt;&lt;br/&gt;• Débit démontré : &lt;b&gt;885,000 rec/sec&lt;/b&gt; (zéro allocation en régime permanent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="397" width="460" height="95" as="geometry" />
        </mxCell>
        <mxCell id="box_durability" value="Moteur WAL (Write-Ahead Log) &amp;amp; Persistance Hôte&lt;br/&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#047857;&quot;&gt;Résilience totale aux crashs &amp;amp; Intégrité binaire certifiée&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#047857;strokeWidth=2;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=10;fontStyle=1;fontSize=12;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="1175" y="520" width="490" height="405" as="geometry" />
        </mxCell>
        <mxCell id="walspool_engine" value="&lt;b&gt;Moteur WAL In-Process (Sub-Microsecond Append)&lt;/b&gt;&lt;br/&gt;• Latence d'écriture disque : &lt;b&gt;22 µs&lt;/b&gt; (avec fsync) / &lt;b&gt;1.5 µs&lt;/b&gt; (Ring Buffer RAM)&lt;br/&gt;• Checksum &lt;b&gt;IEEE CRC32&lt;/b&gt; vérifié systématiquement sur chaque enregistrement&lt;br/&gt;• Checkpoint atomique via swap sécurisé : &lt;code&gt;.tmp&lt;/code&gt; &amp;rarr; &lt;code&gt;.meta&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#047857;strokeWidth=1.5;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="570" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="walspool_storage" value="&lt;b&gt;Disque Local NVMe (Hôte)&lt;/b&gt;&lt;br/&gt;• Répertoire : &lt;code&gt;./data/spool/&lt;/code&gt;&lt;br/&gt;• Segments binaires : &lt;code&gt;*.wal&lt;/code&gt;&lt;br/&gt;• Pointeur d'offset : &lt;code&gt;checkpoint.meta&lt;/code&gt;&lt;br/&gt;• Reprise sans perte après arrêt brutal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="660" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="walspool_drain" value="&lt;b&gt;Batch Drain Worker&lt;/b&gt;&lt;br/&gt;• Évacuation par lots : 50 rec / 50 ms&lt;br/&gt;• Cible externe : Sink HTTPS / S3&lt;br/&gt;• Backoff exponentiel sur erreur 5xx&lt;br/&gt;• Découplage strict des latences distantes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#059669;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1430" y="660" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="walspool_guarantees" value="&lt;b&gt;Garanties Opérationnelles Walspool :&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Zéro Dépendance :&lt;/b&gt; Aucun cluster lourd (pas de Kafka, ni RabbitMQ, ni Redis)&lt;br/&gt;• &lt;b&gt;Isolation des Pannes :&lt;/b&gt; Le crash d'un conteneur ne détruit jamais les logs hôte&lt;br/&gt;• &lt;b&gt;Empreinte Éco-responsable :&lt;/b&gt; Démon Go statique compact, RAM &amp;lt; 30 Mo&lt;br/&gt;• &lt;b&gt;Protection Backpressure :&lt;/b&gt; Quota de stockage configurable (rejet gracieux 503)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1;align=left;spacingLeft=10;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="785" width="460" height="125" as="geometry" />
        </mxCell>
        <mxCell id="box_legend" value="LÉGENDE DÉTAILLÉE : FLUX DE DONNÉES, PROTOCOLES RÉSEAU, PORTS &amp;amp; EN-TÊTES CLÉS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;shadow=1;arcSize=6;verticalAlign=top;align=center;spacingTop=8;fontStyle=1;fontSize=12;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="955" width="1640" height="185" as="geometry" />
        </mxCell>
        <mxCell id="leg_col1" value="&lt;b style=&quot;color:#0f766e;&quot;&gt;FLUX 1 : STREAMING SSE TEMPS RÉEL&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ccfbf1;margin:3px 0 6px 0;&quot;/&gt;&lt;b&gt;Sens :&lt;/b&gt; Walspool &amp;rarr; Gateway &amp;rarr; Nginx &amp;rarr; Navigateur&lt;br/&gt;&lt;b&gt;Protocole :&lt;/b&gt; &lt;code&gt;text/event-stream&lt;/code&gt; (HTTP/1.1 &amp;amp; HTTP/2)&lt;br/&gt;&lt;b&gt;Débuffering Nginx :&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;proxy_buffering: off&lt;/code&gt; (débit immédiat)&lt;br/&gt;• &lt;code&gt;X-Accel-Buffering: no&lt;/code&gt; (désactive le cache proxy)&lt;br/&gt;&lt;b&gt;Heartbeat :&lt;/b&gt; &lt;code&gt;: keepalive&lt;/code&gt; toutes les 10 secondes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="55" y="985" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leg_col2" value="&lt;b style=&quot;color:#5b21b6;&quot;&gt;FLUX 2 : INGESTION LOGS IA ASYNCHRONE&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #ede9fe;margin:3px 0 6px 0;&quot;/&gt;&lt;b&gt;Sens :&lt;/b&gt; Conteneur IA (Django) &amp;rarr; Démon Walspool (:9099)&lt;br/&gt;&lt;b&gt;Protocole :&lt;/b&gt; HTTP POST &lt;code&gt;/v1/enqueue&lt;/code&gt; (Payload JSON)&lt;br/&gt;&lt;b&gt;Mécanisme interne :&lt;/b&gt;&lt;br/&gt;• Thread démon d'arrière-plan dédié&lt;br/&gt;• File d'attente mémoire bornée (5000 items)&lt;br/&gt;• Failsafe : non-bloquant, drop gracieux si saturation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="380" y="985" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leg_col3" value="&lt;b style=&quot;color:#0369a1;&quot;&gt;FLUX 3 : REQUÊTES REST &amp;amp; HISTORIQUE&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #e0f2fe;margin:3px 0 6px 0;&quot;/&gt;&lt;b&gt;Sens :&lt;/b&gt; Navigateur &amp;rarr; Nginx &amp;rarr; API Gateway &amp;rarr; Walspool&lt;br/&gt;&lt;b&gt;Protocole :&lt;/b&gt; HTTPS / JSON (&lt;code&gt;GET /api/v1/observability/logs&lt;/code&gt;)&lt;br/&gt;&lt;b&gt;Source de données :&lt;/b&gt; Interrogation du Ring Buffer (LogHub)&lt;br/&gt;&lt;b&gt;Critères :&lt;/b&gt; &lt;code&gt;trace_id&lt;/code&gt;, &lt;code&gt;service&lt;/code&gt;, &lt;code&gt;level&lt;/code&gt;, &lt;code&gt;limit&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Tolérance :&lt;/b&gt; Timeout 5s et fallback HTTP 502/504 documenté" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="705" y="985" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leg_col4" value="&lt;b style=&quot;color:#b45309;&quot;&gt;EN-TÊTES CLÉS &amp;amp; SÉCURITÉ RÉSEAU&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #fef3c7;margin:3px 0 6px 0;&quot;/&gt;&lt;b&gt;x-request-id :&lt;/b&gt; UUIDv4 propagé pour corréler les traces&lt;br/&gt;&lt;b&gt;Terminaison TLS 1.3 :&lt;/b&gt; Gérée sur le port 443 par &lt;code&gt;docker-cms-1&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Réseau Bridge :&lt;/b&gt; &lt;code&gt;172.99.0.0/24&lt;/code&gt; avec passerelle hôte &lt;code&gt;172.99.0.1&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Isolation :&lt;/b&gt; Services internes LoopBack et Django non exposés directement sur Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="1030" y="985" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="leg_col5" value="&lt;b style=&quot;color:#065f46;&quot;&gt;PERSISTANCE &amp;amp; DRAIN WAL HÔTE&lt;/b&gt;&lt;hr style=&quot;border:0;border-top:1px solid #d1fae5;margin:3px 0 6px 0;&quot;/&gt;&lt;b&gt;Format :&lt;/b&gt; Enregistrement binaire avec CRC32 IEEE sur NVMe&lt;br/&gt;&lt;b&gt;Atomicité :&lt;/b&gt; Remplacement atomique de &lt;code&gt;checkpoint.meta&lt;/code&gt;&lt;br/&gt;&lt;b&gt;Batch Drain :&lt;/b&gt; Vidange par lots (50 items) vers puits distant optionnel&lt;br/&gt;&lt;b&gt;Performance :&lt;/b&gt; Jusqu'à 885,000 ops/sec en RAM, 45,000 ops/sec sur disque" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;align=left;spacingLeft=8;spacingRight=6;spacingTop=6;verticalAlign=top;fontSize=9.5;" vertex="1" parent="1">
          <mxGeometry x="1355" y="985" width="310" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge_1" value="1. HTTPS / TLS 1.3 (:443)&#10;GET /platform/observability&#10;[x-request-id]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2.5;fontColor=#0369a1;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_browser" target="cms_ssl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="235" />
              <mxPoint x="410" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_2" value="2. Distribution SPA (/platform/)&#10;Bundle JS/CSS Platform" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=2;dashed=1;fontColor=#0369a1;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cms_platform" target="card_spa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="410" y="350" />
              <mxPoint x="375" y="350" />
              <mxPoint x="375" y="385" />
              <mxPoint x="345" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_3" value="3. EventSource SSE Connect&#10;GET /api/v1/observability/logs/stream&#10;Accept: text/event-stream | x-request-id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2.5;fontColor=#0f766e;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_client_net" target="cms_sse">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="780" />
              <mxPoint x="370" y="780" />
              <mxPoint x="370" y="445" />
              <mxPoint x="410" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_4" value="4. Proxy Pass (HTTPS :8443)&#10;proxy_buffering off&#10;X-Accel-Buffering: no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2.5;fontColor=#0f766e;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cms_sse" target="gw_sse_pipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="445" />
              <mxPoint x="755" y="445" />
              <mxPoint x="755" y="360" />
              <mxPoint x="780" y="360" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_5" value="5. Proxy SSE vers Hôte&#10;GET http://172.99.0.1:9099/v1/logs/stream&#10;(upstreamRes.pipe)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=2.5;fontColor=#0f766e;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw_sse_pipe" target="walspool_http">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="340" />
              <mxPoint x="1145" y="340" />
              <mxPoint x="1145" y="260" />
              <mxPoint x="1190" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_6" value="6. Flux SSE PUSH Continu (text/event-stream)&#10;JSON StandardLogEvent + : keepalive (10s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=3;fontColor=#047857;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="walspool_sse" target="gw_sse_pipe">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1190" y="445" />
              <mxPoint x="1155" y="445" />
              <mxPoint x="1155" y="385" />
              <mxPoint x="1110" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_7" value="7. Émission Logs IA Asynchrone (HTTP POST /v1/enqueue)&#10;Target: http://172.99.0.1:9099 (service: aipi)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=2.5;fontColor=#5b21b6;fontSize=9;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aipi_worker" target="walspool_http">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="745" />
              <mxPoint x="1148" y="745" />
              <mxPoint x="1148" y="280" />
              <mxPoint x="1190" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_8" value="8. GatewayLogger POST /v1/enqueue (service: api-gateway)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0d9488;strokeWidth=1.5;dashed=1;fontColor=#0f766e;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gw_logger" target="walspool_http">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="452" />
              <mxPoint x="1140" y="452" />
              <mxPoint x="1140" y="240" />
              <mxPoint x="1190" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_9" value="9. Append WAL NVMe (1.5 µs) + CRC32&#10;Swap atomique .tmp -&gt; .meta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#047857;strokeWidth=2.5;fontColor=#065f46;fontSize=8.5;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="walspool_engine" target="walspool_storage">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="650" />
              <mxPoint x="1300" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_10" value="10. Vidange par lots (50 rec / 50 ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;fontColor=#334155;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="walspool_engine" target="walspool_drain">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1540" y="650" />
              <mxPoint x="1540" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_aipi_int_1" value="logger.info()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#5b21b6;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aipi_app" target="aipi_handler">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="745" />
              <mxPoint x="645" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_aipi_int_2" value="queue.put()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#5b21b6;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aipi_handler" target="aipi_worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="880" y="745" />
              <mxPoint x="895" y="745" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_client_int_1" value="es.onmessage &amp;rarr; addLog()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_client_net" target="card_store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="715" />
              <mxPoint x="200" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_client_int_2" value="computed(logs) réactif" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=8.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="card_store" target="card_spa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="515" />
              <mxPoint x="200" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_1_master" name="Page 2 - 1. Architecture &amp; Fonctionnement Interne">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_banner" value="&lt;b&gt;&lt;font style='font-size: 20px; color: #FFFFFF;'&gt;WAL-SPOOL : Le Fonctionnement Interne du Spooler Résilient&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 13px; color: #94A3B8;'&gt;Schéma Pédagogique d'Architecture — Ingestion Express (&amp;lt; 50µs), Zéro Perte sur Crash (WAL + CRC32), Ring Buffer O(1) &amp;amp; Diffusion SSE Temps Réel&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;html=1;align=left;spacingLeft=25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_badge_1" value="⚡ Ingestion &amp;lt; 50 µs" style="rounded=1;arcSize=50;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#15803D;fontStyle=1;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="28" width="140" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_badge_2" value="🛡️ Crash Durability 100%" style="rounded=1;arcSize=50;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#B45309;fontStyle=1;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1180" y="28" width="155" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_badge_3" value="🔄 Ring Buffer O(1)" style="rounded=1;arcSize=50;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1D4ED8;fontStyle=1;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1345" y="28" width="135" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_badge_4" value="🔍 Index &amp;lt; 1 ms" style="rounded=1;arcSize=50;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#6B21A8;fontStyle=1;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1490" y="28" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_senders" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #1E293B;'&gt;1. Applications Émettrices (Producteurs)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontStyle=1;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="310" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p1_apps_desc" value="&lt;b&gt;Services Métier &amp;amp; Micro-services :&lt;/b&gt;&lt;br&gt;• Services Backend (Go, Python, PHP, Node.js)&lt;br&gt;• Passerelles API &amp;amp; Travailleurs asynchrones&lt;br&gt;• Forte charge : des milliers de requêtes/s&lt;br&gt;&lt;br&gt;&lt;i&gt;« L'application doit émettre ses logs d'audit et traces sans JAMAIS attendre ni ralentir l'utilisateur final. »&lt;/i&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="135" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p1_apps_payload" value="&lt;b&gt;Appel HTTP sortant :&lt;/b&gt;&lt;br&gt;&lt;code&gt;&lt;b&gt;POST&lt;/b&gt; /v1/enqueue&lt;/code&gt;&lt;br&gt;&lt;font color='#047857' style='font-size: 11px;'&gt;&lt;b&gt;{&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;topic&quot;: &quot;billing.invoice&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;service&quot;: &quot;billing&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;trace_id&quot;: &quot;tr-9842&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;level&quot;: &quot;INFO&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;payload&quot;: { &quot;amount&quot;: 99.50 }&lt;br&gt;&lt;b&gt;}&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontFamily=Courier New;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="250" width="280" height="165" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp1" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #1E40AF;'&gt;COMPOSANT 1 : Endpoint d'Ingestion&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 12px; color: #3B82F6;'&gt;🏎️ Métaphore : Le Dépose-Minute Express&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=40;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontStyle=1;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="455" width="310" height="395" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp1_details" value="&lt;b&gt;Rôle :&lt;/b&gt; La porte d'entrée éclair de Walspool.&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Validation immédiate :&lt;/b&gt;&lt;br&gt;Vérifie la syntaxe JSON (&amp;lt; 2 Mo) et extrait &lt;i&gt;topic&lt;/i&gt;, &lt;i&gt;service&lt;/i&gt;, &lt;i&gt;trace_id&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Double injection sans blocage :&lt;/b&gt;&lt;br&gt;• Grave le log dans le &lt;b&gt;Moteur WAL Disque&lt;/b&gt;&lt;br&gt;• Indexe le log dans le &lt;b&gt;Ring Buffer Mémoire&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Réponse instantanée au client :&lt;/b&gt;&lt;br&gt;Renvoie le statut HTTP &lt;b&gt;202 Accepted&lt;/b&gt; en &lt;b&gt;&amp;lt; 50 microsecondes&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;div style='background-color:#FEF3C7; padding:6px; border-left:3px solid #D97706; border-radius:4px;'&gt;&lt;b&gt;Garantie Absolue :&lt;/b&gt; L'application cliente reprend ses calculs sur-le-champ. Elle ne subira &lt;b&gt;JAMAIS&lt;/b&gt; la lenteur des bases de données ou du réseau externe !&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="505" width="280" height="255" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp1_status" value="&lt;b&gt;Statuts HTTP retournés :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;202 Accepted&lt;/b&gt; : Pris en charge en &amp;lt; 50 µs&lt;br&gt;• &lt;b&gt;503 Spool Full&lt;/b&gt; : Quota atteint (Backpressure)&lt;br&gt;• &lt;b&gt;400 Bad Request&lt;/b&gt; : Payload ou Topic vide" style="rounded=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#60A5FA;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="770" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_engine" value="&lt;b&gt;&lt;font style='font-size: 16px; color: #0F172A;'&gt;CŒUR DE WALSPOOL (Processus Embarqué Autonome — Architecture Boîte Noire)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=34;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="370" y="95" width="810" height="755" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_hub" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #92400E;'&gt;MOTEUR MÉMOIRE VIVE (MemoryLogHub) — Observabilité &amp;amp; Temps Réel&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=26;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="385" y="135" width="780" height="345" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp3" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #B45309;'&gt;COMPOSANT 3 : Ring Buffer Circulaire&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #D97706;'&gt;🎡 Métaphore : Le Carrousel à 50 000 Places&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#F59E0B;html=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="360" height="295" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp3_content" value="&lt;b&gt;Principe du Ring Buffer (Anneau Fixe) :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Capacité stricte :&lt;/b&gt; 50 000 logs alloués une seule fois au démarrage.&lt;br&gt;• &lt;b&gt;Pointeur circulaire (Head) :&lt;/b&gt; Les nouveaux logs avancent case par case : &lt;code&gt;0 → 1 → ... → 49999&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Écrasement O(1) :&lt;/b&gt; Quand le 50 001ème log arrive, il écrase instantanément le plus vieux sans déplacer les autres.&lt;br&gt;&lt;br&gt;&lt;div style='background-color:#FEF3C7; padding:6px; border-radius:4px; font-size:11px;'&gt;&lt;b&gt;🛡️ ZÉRO FUITE MÉMOIRE :&lt;/b&gt;&lt;br&gt;La mémoire vive allouée ne grossit &lt;b&gt;JAMAIS&lt;/b&gt;. Aucune allocation folle, aucun risque de crash OOM (Out Of Memory) pour votre serveur !&lt;/div&gt;&lt;br&gt;&lt;b&gt;Schéma du carrousel circulaire en RAM :&lt;/b&gt;&lt;br&gt;&lt;center&gt;&lt;code&gt;[0] [1] [2] ... [Head ➜ Log 50 001] ... [49 999]&lt;/code&gt;&lt;/center&gt;" style="text;html=1;fontSize=11;align=left;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="410" y="220" width="340" height="235" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp4" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #6B21A8;'&gt;COMPOSANT 4 : Index Inversés en Mémoire&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #9333EA;'&gt;🗄️ Métaphore : Les Tiroirs de Tri Postal&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#9333EA;html=1;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp4_content" value="• &lt;b&gt;Index Trace ID :&lt;/b&gt; Associe directement &lt;code&gt;tr-9842&lt;/code&gt; aux logs de la transaction.&lt;br&gt;• &lt;b&gt;Index Service :&lt;/b&gt; Regroupe les logs du service &lt;code&gt;billing&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Pointeurs instantanés :&lt;/b&gt; Requête exécutée en &lt;b&gt;&amp;lt; 1 milliseconde (&amp;lt; 1 ms)&lt;/b&gt; sans scanner les 50 000 lignes du carrousel !&lt;br&gt;• &lt;b&gt;Nettoyage synchrone :&lt;/b&gt; Dès qu'un log est écrasé, ses pointeurs dans les tiroirs sont purgés en O(1)." style="text;html=1;fontSize=11;align=left;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="215" width="350" height="85" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp5" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #0E7490;'&gt;COMPOSANT 5 : Broadcaster SSE (Pub/Sub)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #0891B2;'&gt;📻 Métaphore : L'Antenne Radio en Direct&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;html=1;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="320" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp5_content" value="• &lt;b&gt;Push Temps Réel :&lt;/b&gt; Dès qu'un log entre dans le Hub, il est immédiatement poussé aux abonnés HTTP.&lt;br&gt;• &lt;b&gt;Endpoint :&lt;/b&gt; &lt;code&gt;GET /v1/logs/stream?service=billing&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Keepalive 10 secondes :&lt;/b&gt; Envoie un battement de cœur régulier (&lt;code&gt;: keepalive\n\n&lt;/code&gt;) pour empêcher les proxies de clore la connexion.&lt;br&gt;• &lt;b&gt;Filtre dynamique :&lt;/b&gt; Chaque client ne reçoit que les logs qui l'intéressent." style="text;html=1;fontSize=11;align=left;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="365" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_wal" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #065F46;'&gt;MOTEUR DISQUE WAL (FileStorageEngine) — Durabilité Absolue &amp;amp; Zéro Perte&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=26;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.5;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="385" y="495" width="780" height="340" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp2" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #065F46;'&gt;COMPOSANT 2 : Moteur WAL Disque&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #10B981;'&gt;💾 Métaphore : Le Coffre-Fort à Écriture Séquentielle&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#10B981;html=1;align=left;spacing=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="400" y="530" width="360" height="290" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp2_content" value="&lt;b&gt;Fichier actif : &lt;code&gt;active.wal&lt;/code&gt; sur SSD local&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Écriture Append-Only Séquentielle :&lt;/b&gt; Chaque log est gravé à la suite sans déplacement mécanique. Débit maximal du disque (&amp;lt; 2 µs).&lt;br&gt;&lt;br&gt;• &lt;b&gt;Sceau d'intégrité CRC32 IEEE :&lt;/b&gt;&lt;br&gt;Chaque log est protégé par une empreinte mathématique de 4 octets. Si une panne altère un seul bit sur le disque, l'erreur est détectée immédiatement.&lt;br&gt;&lt;br&gt;&lt;div style='background-color:#DCFCE7; padding:6px; border-radius:4px; font-size:11px;'&gt;&lt;b&gt;🛡️ TOLÉRANCE AUX PANNES :&lt;/b&gt;&lt;br&gt;Si le serveur subit une coupure d'électricité (kill -9), &lt;b&gt;AUCUN&lt;/b&gt; log acquitté n'est perdu. Au redémarrage, Walspool rejoue le WAL et reprend sans perte !&lt;/div&gt;" style="text;html=1;fontSize=11;align=left;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="410" y="580" width="340" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_comp6" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #991B1B;'&gt;COMPOSANT 6 : Flusher / Drain Asynchrone&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #DC2626;'&gt;🚚 Métaphore : Le Camion de Livraison en Tâche de Fond&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#EF4444;html=1;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="530" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1_comp6_content" value="• &lt;b&gt;Travailleur d'arrière-plan autonome :&lt;/b&gt; Prélève des lots de 50 à 100 logs sur le disque sans ralentir les entrées.&lt;br&gt;• &lt;b&gt;Double déclencheur :&lt;/b&gt; Lot plein (&lt;code&gt;BatchSize=50&lt;/code&gt;) OU temporisateur écoulé (&lt;code&gt;FlushInterval=50ms&lt;/code&gt;).&lt;br&gt;• &lt;b&gt;Expédition sécurisée :&lt;/b&gt; Envoie vers le stockage externe distant.&lt;br&gt;• &lt;b&gt;Backoff exponentiel :&lt;/b&gt; En cas d'erreur 5xx du récepteur distant, ralentit et retente avec temporisation progressive." style="text;html=1;fontSize=11;align=left;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="575" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_checkpoint" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #1E293B;'&gt;Point de Contrôle Atomique (checkpoint.meta)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style='font-size: 11px; color: #475569;'&gt;🔖 Métaphore : Le Marque-Page Inviolable&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#64748B;html=1;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="680" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1_checkpoint_content" value="• &lt;b&gt;Mémorisation de l'avancement :&lt;/b&gt; Stocke l'offset du dernier log expédié avec succès.&lt;br&gt;• &lt;b&gt;Remplacement atomique (Atomic Swap) :&lt;/b&gt;&lt;br&gt;Écrit dans &lt;code&gt;checkpoint.meta.tmp&lt;/code&gt; puis renomme via &lt;code&gt;os.Rename()&lt;/code&gt;.&lt;br&gt;• &lt;b&gt;Inviolabilité :&lt;/b&gt; Jamais d'état corrompu ou à moitié écrit, même en coupure de courant brutale." style="text;html=1;fontSize=11;align=left;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="725" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1_box_outputs" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #1E293B;'&gt;Consommateurs &amp;amp; Sorties&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontStyle=1;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1210" y="95" width="400" height="755" as="geometry" />
        </mxCell>
        <mxCell id="p1_out_sse" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #0E7490;'&gt;1. Navigateurs &amp;amp; Dashboards en Direct&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Connexion HTTP :&lt;/b&gt; &lt;code&gt;GET /v1/logs/stream&lt;/code&gt;&lt;br&gt;• Réception en temps réel événement par événement (SSE).&lt;br&gt;• Filtres instantanés par &lt;i&gt;service&lt;/i&gt; ou &lt;i&gt;niveau&lt;/i&gt;.&lt;br&gt;• Pas besoin de rafraîchir la page (F5) : le flux défile en direct.&lt;br&gt;• &lt;b&gt;Keepalive toutes les 10s :&lt;/b&gt; La connexion reste vivante sans déconnexion intempestive." style="rounded=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1225" y="140" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p1_out_query" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #6B21A8;'&gt;2. Dev-Cockpit &amp;amp; Diagnostic d'Incident&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Requête HTTP :&lt;/b&gt; &lt;code&gt;GET /v1/logs?trace_id=tr-9842&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Réponse en &amp;lt; 1 milliseconde :&lt;/b&gt; Recherche chirurgicale immédiate grâce aux Index Inversés.&lt;br&gt;• Reconstitue la chronologie exacte d'un bug ou d'une commande client en production.&lt;br&gt;• Idéal pour les ingénieurs support et DevOps." style="rounded=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#9333EA;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1225" y="300" width="370" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p1_out_drain" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #991B1B;'&gt;3. Stockage Externe Long Terme (Drain)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Destinations prises en charge :&lt;/b&gt;&lt;br&gt;• Elasticsearch / Grafana Loki / OpenSearch&lt;br&gt;• AWS S3 / Datadog / Webhooks HTTPS / Kafka&lt;br&gt;• &lt;b&gt;Absorption des pics :&lt;/b&gt; Le serveur externe reçoit des lots stables et réguliers, parfaitement protégés contre les congestions." style="rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1225" y="520" width="370" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p1_out_flush" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #1E293B;'&gt;4. Commande de Vidage Forcé (Flush)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Commande :&lt;/b&gt; &lt;code&gt;POST /flush&lt;/code&gt;&lt;br&gt;• Déclenche la livraison immédiate de tous les logs restants.&lt;br&gt;• Essentiel lors de l'extinction propre (Graceful Shutdown) d'un conteneur Docker / Pod Kubernetes." style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="690" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge_app_to_comp1" value="&lt;b&gt;1. POST /v1/enqueue&lt;/b&gt;&lt;br&gt;&lt;font color='#16A34A'&gt;&lt;b&gt;&amp;lt; 50 µs (202 Accepted)&lt;/b&gt;&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E293B;fontSize=11;" edge="1" parent="1" source="p1_apps_payload" target="p1_box_comp1">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_comp1_to_hub" value="&lt;b&gt;2a. Ingestion RAM&lt;/b&gt;&lt;br&gt;Ring Buffer 50k O(1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2.5;fontColor=#B45309;fontSize=10;" edge="1" parent="1" source="p1_box_comp1" target="p1_box_comp3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="520" />
              <mxPoint x="350" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_comp1_to_wal" value="&lt;b&gt;2b. Écriture Disque&lt;/b&gt;&lt;br&gt;Append WAL + CRC32" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2.5;fontColor=#065F46;fontSize=10;" edge="1" parent="1" source="p1_box_comp1" target="p1_box_comp2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_hub_to_index" value="Indexation Trace &amp;amp; Service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=10;" edge="1" parent="1" source="p1_box_comp3" target="p1_box_comp4">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_hub_to_sse" value="Événement temps réel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0891B2;strokeWidth=2;fontColor=#0E7490;fontSize=10;" edge="1" parent="1" source="p1_box_comp3" target="p1_box_comp5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_sse_to_browser" value="&lt;b&gt;Flux SSE direct&lt;/b&gt;&lt;br&gt;Keepalive 10s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#0891B2;strokeWidth=2.5;fontColor=#0E7490;fontSize=10;" edge="1" parent="1" source="p1_box_comp5" target="p1_out_sse">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_index_to_query" value="&lt;b&gt;Résultat &amp;lt; 1 ms&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=2.5;fontColor=#6B21A8;fontSize=10;" edge="1" parent="1" source="p1_box_comp4" target="p1_out_query">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_wal_to_flusher" value="Lecture par lots (50 logs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=10;" edge="1" parent="1" source="p1_box_comp2" target="p1_box_comp6">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_flusher_to_checkpoint" value="Validation Offset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#64748B;strokeWidth=2;dashed=1;fontColor=#475569;fontSize=10;" edge="1" parent="1" source="p1_box_comp6" target="p1_box_checkpoint">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_flusher_to_drain" value="&lt;b&gt;Expédition par lots&lt;/b&gt;&lt;br&gt;HTTPS / S3 / Kafka" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=2.5;fontColor=#991B1B;fontSize=10;" edge="1" parent="1" source="p1_box_comp6" target="p1_out_drain">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_flush_to_worker" value="Ordre de vidage immédiat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;dashed=1;fontColor=#475569;fontSize=10;" edge="1" parent="1" source="p1_out_flush" target="p1_box_comp6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1210" y="755" />
              <mxPoint x="1160" y="755" />
              <mxPoint x="1160" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p1_box_footer" value="&lt;b&gt;&lt;font style='font-size: 13px; color: #0F172A;'&gt;LES 4 RÈGLES D'OR DU DESIGN BLACK-BOX DE WALSPOOL&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=26;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="870" width="1580" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p1_card_rule1" value="&lt;b&gt;1. DÉCOUPLAGE TOTAL (SPOOL)&lt;/b&gt;&lt;br&gt;L'application cliente ne dépend jamais de la disponibilité du stockage externe. L'ingestion en &amp;lt; 50 µs libère instantanément les workers applicatifs." style="rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="905" width="365" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_card_rule2" value="&lt;b&gt;2. ZÉRO PERTE (WAL + CRC32)&lt;/b&gt;&lt;br&gt;Chaque log accepté est immédiatement gravé sur disque SSD avec sa somme de contrôle IEEE CRC32. Tolérance totale aux pannes électriques (crash-proof)." style="rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#10B981;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="435" y="905" width="365" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_card_rule3" value="&lt;b&gt;3. MÉMOIRE MAÎTRISÉE (RING BUFFER)&lt;/b&gt;&lt;br&gt;Capacité fixe de 50 000 logs allouée au démarrage. Remplacement instantané en O(1). Zéro fuite mémoire, zéro pic de Garbage Collector." style="rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="825" y="905" width="365" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p1_card_rule4" value="&lt;b&gt;4. OBSERVABILITÉ VIVANTE (SSE &amp;amp; INDEX)&lt;/b&gt;&lt;br&gt;Diffusion temps réel sans rafraîchissement avec signal keepalive 10s, et recherche chirurgicale par trace distribuée en &amp;lt; 1 milliseconde." style="rounded=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#9333EA;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1215" y="905" width="380" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_2_essence" name="Page 3 - 2. Pourquoi WAL-SPOOL ? (Métaphores &amp; Essence)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_banner" value="&lt;b&gt;&lt;font style='font-size: 20px; color: #FFFFFF;'&gt;Pourquoi « WAL-SPOOL » ? Démystification &amp;amp; Métaphores Visuelles&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 13px; color: #94A3B8;'&gt;Deux piliers de l'ingénierie logicielle réunis pour résoudre définitivement le dilemme des logs et événements d'audit&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;html=1;align=left;spacingLeft=25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_box_wal" value="&lt;b&gt;&lt;font style='font-size: 16px; color: #065F46;'&gt;1. « WAL » = Write-Ahead Log (Le Journal Écrit Avant Tout)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="105" width="695" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p2_wal_metaphor" value="&lt;b&gt;📜 La Métaphore du Notaire &amp;amp; du Grand Livre Inaltérable :&lt;/b&gt;&lt;br&gt;&lt;br&gt;Avant de réaliser une transaction ou de modifier l'état du monde, le notaire inscrit d'abord la décision dans un grand registre relié à l'encre indélébile.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi « Write-Ahead » (Écrit Avant) ?&lt;/b&gt;&lt;br&gt;• Walspool ne prend AUCUN risque : avant d'indexer en mémoire, avant d'appeler le réseau, le log est d'abord gravé physiquement sur le disque local.&lt;br&gt;• Dès que l'écriture disque est effectuée, Walspool répond &lt;code&gt;202 Accepted&lt;/code&gt;. Le contrat est scellé.&lt;br&gt;&lt;br&gt;&lt;b&gt;Pourquoi l'écriture séquentielle sur SSD est magique ?&lt;/b&gt;&lt;br&gt;• Dans une base classique, chercher où ranger une donnée demande des calculs et des mouvements de tête de lecture (aléatoire).&lt;br&gt;• Dans un WAL, on écrit toujours &lt;b&gt;à la suite du fichier (Append-Only)&lt;/b&gt;. Sur un SSD NVMe moderne, cela ne prend que &lt;b&gt;1.5 microseconde&lt;/b&gt; !&lt;br&gt;&lt;br&gt;&lt;b&gt;Le Sceau de Cire CRC32 :&lt;/b&gt;&lt;br&gt;Chaque log est scellé avec un calcul mathématique IEEE CRC32. Si le courant est coupé pendant l'écriture d'un octet, le log est immédiatement identifié comme incomplet et rejeté proprement au redémarrage." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontSize=12;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="665" height="370" as="geometry" />
        </mxCell>
        <mxCell id="p2_box_spool" value="&lt;b&gt;&lt;font style='font-size: 16px; color: #1E40AF;'&gt;2. « SPOOL » = Réservoir Tampon / Amortisseur de Choc&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=32;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="775" y="105" width="695" height="430" as="geometry" />
        </mxCell>
        <mxCell id="p2_spool_metaphor" value="&lt;b&gt;🏰 La Métaphore du Château d'Eau &amp;amp; des Orages Soudains :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;L'Histoire du mot SPOOL :&lt;/b&gt;&lt;br&gt;Inventé aux débuts de l'informatique (&lt;i&gt;Simultaneous Peripheral Operations On-Line&lt;/i&gt;) pour empêcher les ordinateurs ultra-rapides de s'arrêter en attendant les imprimantes mécaniques lentes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Le Problème sans Spool :&lt;/b&gt;&lt;br&gt;Lors d'un pic de ventes (ex: Black Friday), votre site reçoit 50 000 requêtes/seconde. Si chaque requête tente d'appeler directement Elasticsearch ou un webhook externe, le réseau externe sature, les connexions bloquent, et tout votre site web s'effondre en cascade avec des erreurs 504 Gateway Timeout !&lt;br&gt;&lt;br&gt;&lt;b&gt;La Réponse du Spool :&lt;/b&gt;&lt;br&gt;Le Spool agit comme un &lt;b&gt;château d'eau géant&lt;/b&gt; :&lt;br&gt;• Il absorbe instantanément l'orage diluvien (les pics de logs) en &amp;lt; 50 µs sans jamais ralentir la pluie (l'API cliente).&lt;br&gt;• Puis, au calme en arrière-plan, il distribue l'eau avec un débit parfaitement régulier et maîtrisé (des lots de 50 logs toutes les 50ms) vers les systèmes externes." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontSize=12;html=1;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="665" height="370" as="geometry" />
        </mxCell>
        <mxCell id="p2_box_compare" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #0F172A;'&gt;TABLEAU COMPARATIF : POURQUOI LES ANCIENNES APPROCHES ÉCHOUENT FACE À WALSPOOL&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#94A3B8;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="560" width="1440" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p2_th_crit" value="&lt;b&gt;Critères d'Évaluation&lt;/b&gt;" style="rounded=0;fillColor=#0F172A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="600" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_th_http" value="&lt;b&gt;1. Appel HTTP Direct Synchrone&lt;/b&gt;" style="rounded=0;fillColor=#FEE2E2;fontColor=#991B1B;fontSize=12;fontStyle=1;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="285" y="600" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_th_ram" value="&lt;b&gt;2. Queue RAM Basique (Channels Go)&lt;/b&gt;" style="rounded=0;fillColor=#FEF3C7;fontColor=#92400E;fontSize=12;fontStyle=1;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="600" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_th_kafka" value="&lt;b&gt;3. Broker Distribué (Kafka / SQS)&lt;/b&gt;" style="rounded=0;fillColor=#E0E7FF;fontColor=#3730A3;fontSize=12;fontStyle=1;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="600" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_th_wal" value="&lt;b&gt;4. Walspool (In-Process WAL+Spool)&lt;/b&gt;" style="rounded=0;fillColor=#DCFCE7;fontColor=#065F46;fontSize=12;fontStyle=1;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="600" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1_c0" value="&lt;b&gt;Latence pour l'API émettrice&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="640" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1_c1" value="&lt;b&gt;50 à 800 ms&lt;/b&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;Bloque les requêtes des utilisateurs&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="285" y="640" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1_c2" value="&lt;b&gt;&amp;lt; 1 µs&lt;/b&gt;&lt;br&gt;&lt;font color='#16A34A'&gt;Très rapide en mémoire&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="640" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1_c3" value="&lt;b&gt;5 à 15 ms&lt;/b&gt;&lt;br&gt;&lt;font color='#D97706'&gt;Latence réseau TCP vers le cluster&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="640" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r1_c4" value="&lt;b&gt;&amp;lt; 50 µs HTTP (&amp;lt; 2 µs natif)&lt;/b&gt;&lt;br&gt;&lt;font color='#15803D'&gt;&lt;b&gt;Ultra-rapide &amp;amp; non-bloquant&lt;/b&gt;&lt;/font&gt;" style="rounded=0;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="640" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2_c0" value="&lt;b&gt;Résilience après crash (Kill -9)&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="705" width="65" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2_c1" value="❌ &lt;b&gt;Perte totale&lt;/b&gt; en cas de timeout" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="285" y="705" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2_c2" value="❌ &lt;b&gt;Perte totale des données en RAM&lt;/b&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;Violation de conformité audit/SOC2&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="705" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2_c3" value="✅ &lt;b&gt;Élevée&lt;/b&gt; (Réplication inter-nœuds)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="705" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r2_c4" value="✅ &lt;b&gt;100% Indestructible (WAL+CRC32)&lt;/b&gt;&lt;br&gt;&lt;font color='#15803D'&gt;Reprise automatique sans aucune perte&lt;/font&gt;" style="rounded=0;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="705" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3_c0" value="&lt;b&gt;Coût d'infrastructure cloud&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="770" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3_c1" value="&lt;b&gt;0 $&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="285" y="770" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3_c2" value="&lt;b&gt;0 $&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="770" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3_c3" value="&lt;b&gt;500 $ à 3 500 $/mois&lt;/b&gt;&lt;br&gt;&lt;font color='#DC2626'&gt;Factures clusters, disques EBS, ingress&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="770" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r3_c4" value="&lt;b&gt;0 $ (Intégré localement)&lt;/b&gt;&lt;br&gt;&lt;font color='#15803D'&gt;Aucun composant cloud requis&lt;/font&gt;" style="rounded=0;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="770" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4_c0" value="&lt;b&gt;Complexité opérationnelle&lt;/b&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="835" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4_c1" value="Faible mais provoque des pannes en cascade sur les serveurs applicatifs" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="285" y="835" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4_c2" value="Moyenne (fuites mémoire fréquentes lors des blocages de goroutines)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="835" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4_c3" value="Très élevée (gestion des partitions, rééquilibrages de consommateurs, zookeeper)" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="835" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_r4_c4" value="&lt;b&gt;ZÉRO maintenance&lt;/b&gt;&lt;br&gt;&lt;font color='#15803D'&gt;Un seul binaire léger en Go, auto-réparateur, sans aucune dépendance externe&lt;/font&gt;" style="rounded=0;fillColor=#F0FDF4;strokeColor=#86EFAC;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1125" y="835" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p2_edge_wal_to_spool" value="&lt;b&gt;Enregistrement préalable (WAL)&lt;/b&gt;&lt;br&gt;Sécurisation sur disque" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2.5;fontColor=#065F46;fontSize=11;" edge="1" parent="1" source="p2_box_wal" target="p2_box_spool">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_3_memory" name="Page 4 - 3. Zoom Mémoire (Ring Buffer &amp; Index)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_banner" value="&lt;b&gt;&lt;font style='font-size: 20px; color: #FFFFFF;'&gt;Zoom Mémoire : Le Ring Buffer Circulaire &amp;amp; Les Index Inversés&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 13px; color: #94A3B8;'&gt;Comment stocker 50 000 logs en RAM sans fuite mémoire et filtrer en &amp;lt; 1 milliseconde sans scanner toute la liste&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;html=1;align=left;spacingLeft=25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p3_box_ring" value="&lt;b&gt;&lt;font style='font-size: 15px; color: #92400E;'&gt;A. Le Ring Buffer Circulaire à Capacité Fixe (50 000 logs)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="105" width="695" height="845" as="geometry" />
        </mxCell>
        <mxCell id="p3_ring_concept" value="&lt;b&gt;Pourquoi un Anneau Circulaire et non une simple liste ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dans la plupart des programmes, quand on ajoute des logs dans une liste standard :&lt;br&gt;1. La liste grossit indéfiniment en mémoire RAM.&lt;br&gt;2. Si le serveur tourne longtemps, la RAM se remplit et le serveur plante (&lt;b&gt;Crash OOM&lt;/b&gt;).&lt;br&gt;3. Supprimer le premier élément d'une liste classique oblige l'ordinateur à décaler tous les éléments suivants en mémoire (extrêmement lent : complexité O(N)).&lt;br&gt;&lt;br&gt;&lt;b&gt;La Solution Walspool : L'Anneau à 50 000 Places Fixes&lt;/b&gt;&lt;br&gt;• Un tableau pré-alloué de 50 000 cases numérotées de &lt;code&gt;0&lt;/code&gt; à &lt;code&gt;49999&lt;/code&gt;.&lt;br&gt;• Un pointeur &lt;b&gt;Head&lt;/b&gt; mémorise l'emplacement du prochain log à écrire.&lt;br&gt;• L'empreinte mémoire reste &lt;b&gt;parfaitement constante&lt;/b&gt; (environ 25 Mo)." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#FDE68A;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="665" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p3_ring_visual_box" value="&lt;b&gt;Visualisation de la rotation dans l'anneau :&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="45" y="340" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_0" value="&lt;b&gt;Slot [0]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="375" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_0" value="Log #1 (Plus ancien) ➜ Écrasé par Log #50001 !" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="375" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_1" value="&lt;b&gt;Slot [1]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="420" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_1" value="Log #2" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="420" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_2" value="&lt;b&gt;Slot [2]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="465" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_2" value="Log #3" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="465" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_3" value="&lt;b&gt;Slot [3]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="510" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_3" value="Log #4" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="510" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_dots" value="&lt;b&gt;Slot [...]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="555" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_dots" value="... 49 990 logs intermédiaires ..." style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="555" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_49998" value="&lt;b&gt;Slot [49998]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="600" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_49998" value="Log #49999" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="600" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_slot_Slot_49999" value="&lt;b&gt;Slot [49999]&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="645" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_desc_Slot_49999" value="Log #50000 (Dernier inséré avant rebouclage)" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=11;html=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="165" y="645" width="545" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3_o1_box" value="&lt;b&gt;⚡ Le Mécanisme d'Écrasement Instantané O(1) :&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lorsque le &lt;b&gt;50 001ème log&lt;/b&gt; arrive :&lt;br&gt;1. La formule mathématique calcule la case : &lt;code&gt;head = (head + 1) % 50000&lt;/code&gt;.&lt;br&gt;2. Le log n°1 qui était dans la case &lt;code&gt;[0]&lt;/code&gt; est remplacé &lt;b&gt;directement en mémoire&lt;/b&gt; par le log n°50 001.&lt;br&gt;3. &lt;b&gt;Aucun déplacement d'éléments :&lt;/b&gt; L'opération prend 1 seule instruction processeur (&lt;b&gt;temps constant O(1)&lt;/b&gt;).&lt;br&gt;4. &lt;b&gt;Zéro Garbage Collection :&lt;/b&gt; Comme la case existait déjà, le moteur de mémoire n'a rien à recycler. Fluidité absolue !" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="705" width="665" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3_box_index" value="&lt;b&gt;&lt;font style='font-size: 15px; color: #6B21A8;'&gt;B. Les Index Inversés (Trace ID &amp;amp; Service) &amp;lt; 1 ms&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="775" y="105" width="695" height="845" as="geometry" />
        </mxCell>
        <mxCell id="p3_index_concept" value="&lt;b&gt;Le Problème sans Index Inversé (Le Scan Séquentiel) :&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pour trouver les logs de la commande &lt;code&gt;tr-9842&lt;/code&gt; parmi 50 000 logs :&lt;br&gt;• Sans index, l'ordinateur doit lire chaque log du 1er au 50 000ème et vérifier si la trace correspond.&lt;br&gt;• Ce parcours prend &lt;b&gt;50 à 200 millisecondes&lt;/b&gt; et fait chauffer le processeur.&lt;br&gt;&lt;br&gt;&lt;b&gt;La Solution Walspool : Le Meuble de Tri Postal à Tiroirs Directs&lt;/b&gt;&lt;br&gt;• Au moment même où un log entre dans Walspool, son adresse mémoire est glissée dans le bon casier.&lt;br&gt;• Lorsqu'une requête arrive, on tire directement le casier : réponse en &lt;b&gt;&amp;lt; 1 milliseconde&lt;/b&gt; !" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#E9D5FF;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="665" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p3_drawers_visual_title" value="&lt;b&gt;Architecture interne des deux tables d'index inversés :&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="p3_drawer_trace" value="&lt;b&gt;🗄️ Tiroir 1 : Table d'Index par Trace ID (&lt;code&gt;byTraceID&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;• Clé &lt;code&gt;&quot;tr-9842&quot;&lt;/code&gt; ➜ [ Adresse Pointeur Log #42, Adresse Pointeur Log #88 ]&lt;br&gt;• Clé &lt;code&gt;&quot;tr-5510&quot;&lt;/code&gt; ➜ [ Adresse Pointeur Log #105, Log #108, Log #112 ]&lt;br&gt;• Clé &lt;code&gt;&quot;tr-7701&quot;&lt;/code&gt; ➜ [ Adresse Pointeur Log #301 ]&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A855F7;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="375" width="665" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_drawer_service" value="&lt;b&gt;🗄️ Tiroir 2 : Table d'Index par Nom de Service (&lt;code&gt;byService&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px;'&gt;• Clé &lt;code&gt;&quot;billing&quot;&lt;/code&gt; ➜ [ Pointeurs vers 1 250 logs du service facturation ]&lt;br&gt;• Clé &lt;code&gt;&quot;auth&quot;&lt;/code&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;➜ [ Pointeurs vers 3 400 logs d'authentification ]&lt;br&gt;• Clé &lt;code&gt;&quot;catalog&quot;&lt;/code&gt; ➜ [ Pointeurs vers 820 logs du catalogue ]&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A855F7;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="495" width="665" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3_drawer_sync" value="&lt;b&gt;🔄 Synchronisation &amp;amp; Purge Zéro-Fuite :&lt;/b&gt;&lt;br&gt;&lt;br&gt;Que se passe-t-il lorsque le log n°1 est écrasé dans le Ring Buffer par le log n°50 001 ?&lt;br&gt;&lt;br&gt;1. Walspool lit les métadonnées du vieux log n°1 (ex: Service &lt;code&gt;billing&lt;/code&gt;, Trace &lt;code&gt;tr-0001&lt;/code&gt;).&lt;br&gt;2. Il ouvre le tiroir &lt;code&gt;billing&lt;/code&gt; et le tiroir &lt;code&gt;tr-0001&lt;/code&gt; pour &lt;b&gt;retirer le pointeur du log n°1&lt;/b&gt;.&lt;br&gt;3. Il insère ensuite les pointeurs du nouveau log n°50 001 dans leurs tiroirs respectifs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Résultat mathématique :&lt;/b&gt;&lt;br&gt;Les tiroirs ne contiennent &lt;b&gt;JAMAIS&lt;/b&gt; de pointeurs fantômes vers des logs disparus. La mémoire reste claire et les requêtes renvoient toujours la vérité exacte en &lt;b&gt;&amp;lt; 1 ms&lt;/b&gt;." style="rounded=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#9333EA;fontSize=11;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="790" y="615" width="665" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_query_example" value="&lt;b&gt;Exemple concret de requête utilisateur :&lt;/b&gt;&lt;br&gt;&lt;code&gt;GET /v1/logs?trace_id=tr-9842&amp;amp;limit=50&lt;/code&gt;&lt;br&gt;➜ Saut direct dans le tiroir &lt;code&gt;tr-9842&lt;/code&gt; ➜ Récupère les 2 logs en &lt;b&gt;0.3 ms&lt;/b&gt; ➜ Renvoyé au Dev-Cockpit." style="rounded=1;arcSize=6;fillColor=#F3E8FF;strokeColor=#C084FC;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="790" width="665" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_edge_evict_sync" value="&lt;b&gt;Purge synchrone&lt;/b&gt;&lt;br&gt;Supprime les pointeurs obsolètes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=10;" edge="1" parent="1" source="p3_slot_Slot_0" target="p3_drawer_sync">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_edge_query_drawer" value="&lt;b&gt;Accès direct &amp;lt; 1 ms&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7C3AED;strokeWidth=2.5;fontColor=#6D28D9;fontSize=10;" edge="1" parent="1" source="p3_query_example" target="p3_drawer_trace">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1465" y="815" />
              <mxPoint x="1475" y="425" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_4_disk" name="Page 5 - 4. Zoom Disque (Moteur WAL &amp; Crash)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_banner" value="&lt;b&gt;&lt;font style='font-size: 20px; color: #FFFFFF;'&gt;Zoom Disque : Moteur WAL, Trame Binaire CRC32 &amp;amp; Reprise après Crash&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 13px; color: #94A3B8;'&gt;Comment garantir une intégrité mathématique absolue et zéro perte de données même si le serveur perd son alimentation électrique&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#0F172A;strokeColor=#1E293B;html=1;align=left;spacingLeft=25;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1440" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p4_box_binary" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #065F46;'&gt;A. Anatomie de la Trame Binaire Disque (En-tête de 29 octets + Données)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=28;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="105" width="1440" height="245" as="geometry" />
        </mxCell>
        <mxCell id="p4_binary_intro" value="Chaque log enregistré dans le fichier &lt;code&gt;active.wal&lt;/code&gt; commence par un en-tête ultra-compact de &lt;b&gt;29 octets&lt;/b&gt; auto-délimité :" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="45" y="140" width="1000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_0" value="&lt;b&gt;Magic (2B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;0x57 0x4C ('WL')&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="170" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_0" value="&lt;font size='1'&gt;Identifiant unique Walspool&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="45" y="225" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_1" value="&lt;b&gt;Ver (1B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;0x01&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#E0E7FF;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="170" y="170" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_1" value="&lt;font size='1'&gt;Version du protocole&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="170" y="225" width="90" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_2" value="&lt;b&gt;CRC32 (4B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;0x8F 0x2A ...&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="265" y="170" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_2" value="&lt;font size='1'&gt;Somme de contrôle IEEE 802.3&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="265" y="225" width="150" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_3" value="&lt;b&gt;ID (8B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Uint64 (Atomic)&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="170" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_3" value="&lt;font size='1'&gt;Numéro d'ordre unique&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="420" y="225" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_4" value="&lt;b&gt;Time (8B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Unix Nano&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FFEDD5;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="565" y="170" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_4" value="&lt;font size='1'&gt;Horodatage nanoseconde&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="565" y="225" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_5" value="&lt;b&gt;TopicLen (2B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Uint16&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F3E8FF;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="710" y="170" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_5" value="&lt;font size='1'&gt;Taille nom du topic&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="710" y="225" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_6" value="&lt;b&gt;PayloadLen (4B)&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Uint32&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FCE7F3;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="845" y="170" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_6" value="&lt;font size='1'&gt;Taille du JSON utile&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="845" y="225" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_7" value="&lt;b&gt;Topic Bytes&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Variable&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="990" y="170" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_7" value="&lt;font size='1'&gt;Nom du sujet (ex: 'billing')&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="990" y="225" width="170" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_8" value="&lt;b&gt;Payload Bytes&lt;/b&gt;&lt;br&gt;&lt;font size='1'&gt;Variable&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=11;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1165" y="170" width="315" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_hdr_desc_8" value="&lt;font size='1'&gt;Charge JSON brute&lt;/font&gt;" style="text;html=1;fontSize=10;align=center;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="1165" y="225" width="315" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p4_binary_why" value="&lt;b&gt;Pourquoi ce format est-il surpuissant ?&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Zéro désérialisation lourde :&lt;/b&gt; Le moteur lit les 29 premiers octets en 1 seul appel I/O. Il connaît immédiatement la taille exacte du message et son CRC32 sans analyser le texte.&lt;br&gt;• &lt;b&gt;Saut rapide :&lt;/b&gt; En cas de reprise après panne, le moteur saute de record en record sans lire le contenu du JSON, ce qui permet de vérifier 100 000 logs en quelques millisecondes !" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A7F3D0;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="275" width="1410" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_box_atomic_chk" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #1E40AF;'&gt;B. Le Checkpoint Atomique (checkpoint.meta)&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="370" width="695" height="580" as="geometry" />
        </mxCell>
        <mxCell id="p4_chk_expl" value="&lt;b&gt;Le Problème du fichier d'état dans les systèmes fragiles :&lt;/b&gt;&lt;br&gt;&lt;br&gt;Si un programme écrit directement dans &lt;code&gt;checkpoint.meta&lt;/code&gt; et que le courant coupe au milieu de l'opération :&lt;br&gt;• Le fichier se retrouve tronqué à 0 octet ou rempli de caractères corrompus.&lt;br&gt;• Au redémarrage, le système ne sait plus où il en était et perd des données.&lt;br&gt;&lt;br&gt;&lt;b&gt;L'Algorithme Atomique de Walspool (Double-Verrou) :&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Étape 1 : Écriture temporaire&lt;/b&gt;&lt;br&gt;Le Flusher vient de livrer avec succès le log #4500 au stockage externe. Il écrit l'offset &lt;code&gt;4500&lt;/code&gt; dans un fichier temporaire : &lt;code&gt;checkpoint.meta.tmp&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Étape 2 : Forçage physique (Fsync)&lt;/b&gt;&lt;br&gt;Walspool force l'écriture des données physiques sur la puce mémoire du SSD.&lt;br&gt;&lt;br&gt;&lt;b&gt;Étape 3 : Remplacement Atomique (Atomic Rename)&lt;/b&gt;&lt;br&gt;Walspool invoque la commande système &lt;code&gt;os.Rename('checkpoint.meta.tmp', 'checkpoint.meta')&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;div style='background-color:#DBEAFE; padding:8px; border-radius:4px; font-size:11px;'&gt;&lt;b&gt;🛡️ GARANTIE DU SYSTÈME D'EXPLOITATION LINUX / UNIX :&lt;/b&gt;&lt;br&gt;L'opération de renommage est &lt;b&gt;atomique&lt;/b&gt; au niveau des descripteurs de fichiers (inodes). Il est &lt;b&gt;physiquement impossible&lt;/b&gt; que le fichier soit à moitié écrit. Soit l'ancienne version existe, soit la nouvelle est active !&lt;/div&gt;" style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#BFDBFE;fontSize=12;html=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="415" width="665" height="520" as="geometry" />
        </mxCell>
        <mxCell id="p4_box_crash_scenario" value="&lt;b&gt;&lt;font style='font-size: 14px; color: #991B1B;'&gt;C. Chronologie Réelle : Panne Électrique &amp;amp; Zéro Perte&lt;/font&gt;&lt;/b&gt;" style="swimlane;startSize=30;rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;html=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="775" y="370" width="695" height="580" as="geometry" />
        </mxCell>
        <mxCell id="p4_step_step1" value="&lt;b&gt;&lt;font color='#16A34A'&gt;14:02:00.100 — Fonctionnement Normal&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px; color: #1E293B;'&gt;• 5 000 logs reçus et gravés dans &lt;code&gt;active.wal&lt;/code&gt;.&lt;br&gt;• Le Flusher a déjà expédié les logs 1 à 4 800 vers Elasticsearch.&lt;br&gt;• Fichier &lt;code&gt;checkpoint.meta&lt;/code&gt; validé à l'offset &lt;b&gt;4800&lt;/b&gt;.&lt;br&gt;• Les logs 4801 à 5000 attendent le prochain drain de 50 ms.&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="415" width="665" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4_step_step2" value="&lt;b&gt;&lt;font color='#DC2626'&gt;14:02:00.105 — ⚡ COUPURE DE COURANT BRUTALE !&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px; color: #1E293B;'&gt;• Le câble d'alimentation du serveur est arraché (ou &lt;code&gt;kill -9&lt;/code&gt;).&lt;br&gt;• La mémoire vive RAM s'éteint instantanément : tout son contenu s'évapore.&lt;br&gt;• &lt;b&gt;Mais sur le SSD :&lt;/b&gt; les logs 4801 à 5000 étaient déjà gravés avec leur CRC32 !&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FEE2E2;strokeColor=#DC2626;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="520" width="665" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4_edge_p4_step_step1_step2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1" source="p4_step_step1" target="p4_step_step2">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_step_step3" value="&lt;b&gt;&lt;font color='#2563EB'&gt;14:02:45.000 — Redémarrage du Serveur&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px; color: #1E293B;'&gt;• L'électricité revient, le conteneur Walspool redémarre automatiquement.&lt;br&gt;• Le moteur lance sa routine de récupération : &lt;code&gt;FileStorageEngine.recover()&lt;/code&gt;.&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="625" width="665" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4_edge_p4_step_step2_step3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1" source="p4_step_step2" target="p4_step_step3">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_step_step4" value="&lt;b&gt;&lt;font color='#D97706'&gt;14:02:45.015 — Phase de Diagnostic &amp;amp; Reprise&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px; color: #1E293B;'&gt;1. Walspool lit &lt;code&gt;checkpoint.meta&lt;/code&gt; ➔ Offset confirmé = &lt;b&gt;4800&lt;/b&gt;.&lt;br&gt;2. Il se positionne directement dans &lt;code&gt;active.wal&lt;/code&gt; à partir du log &lt;b&gt;4801&lt;/b&gt;.&lt;br&gt;3. Il vérifie les sommes CRC32 des logs 4801 à 5000 : &lt;b&gt;Toutes valides !&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="730" width="665" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4_edge_p4_step_step3_step4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1" source="p4_step_step3" target="p4_step_step4">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_step_step5" value="&lt;b&gt;&lt;font color='#15803D'&gt;14:02:45.030 — Résultat : ZÉRO PERTE !&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size: 11px; color: #1E293B;'&gt;• Le Flusher d'arrière-plan expédie immédiatement les logs 4801 à 5000 vers Elasticsearch.&lt;br&gt;• L'API d'ingestion rouvre ses portes en &amp;lt; 50 µs.&lt;br&gt;• &lt;b&gt;Bilan : 0 log perdu, 0 doublon, 0 intervention humaine requise.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=11;html=1;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="835" width="665" height="95" as="geometry" />
        </mxCell>
        <mxCell id="p4_edge_p4_step_step4_step5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=classic;" edge="1" parent="1" source="p4_step_step4" target="p4_step_step5">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="trace_and_sse_lifecycle" name="Page 6 - Flux de Données &amp; Cycle de Vie d'une Requête">
    <mxGraphModel dx="1720" dy="2650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="2650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" value="&lt;b style=&quot;font-size:18px;&quot;&gt;FLUX DE DONNÉES &amp;amp; CYCLE DE VIE D'UNE REQUÊTE : TRAÇABILITÉ DISTRIBUÉE &amp;amp; STREAMING SSE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px; color:#546e7a;&quot;&gt;Corrélation de bout en bout via &lt;b style=&quot;color:#1e88e5;&quot;&gt;x-request-id&lt;/b&gt; • Propagation asynchrone (AsyncLocalStorage / contextvars) • Télémétrie non-bloquante Walspool &amp;amp; Cascade Waterfall Gantt&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#b0bec5;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1640" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p1_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Client Métier&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;Navigateur / Frontend Utilisateur&lt;br&gt;&lt;i&gt;Appel API &amp;amp; Consommation IA&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_line" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="p1_head">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;API Gateway&lt;/b&gt; (Port 3000)&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;LoopBack 4 (TypeScript / Node.js)&lt;br&gt;&lt;i&gt;TraceMiddleware • AsyncLocalStorage&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="390" y="95" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2_line" style="endArrow=none;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="p2_head">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Microservice AIPI&lt;/b&gt; (Port 8000)&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;Django 4.2 (Python 3.10)&lt;br&gt;&lt;i&gt;TraceMiddleware • contextvars • WalspoolHandler&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="95" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p3_line" style="endArrow=none;dashed=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p3_head">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Walspool Sidecar&lt;/b&gt; (Port 9099)&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;Moteur Spooler &amp;amp; Ingestion (Go 1.21)&lt;br&gt;&lt;i&gt;Disk WAL • MemoryLogHub • SSE Hub&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="95" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_line" style="endArrow=none;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p4_head">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5_head" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Console Platform&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#455a64&quot;&gt;Vue 3 • Pinia (/platform/observability)&lt;br&gt;&lt;i&gt;useObservabilityStore • EventSource&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;strokeWidth=2;shadow=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1430" y="95" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p5_line" style="endArrow=none;dashed=1;html=1;strokeColor=#10739e;strokeWidth=2;" edge="1" parent="1" source="p5_head">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1550" y="2350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gw_active" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="505" y="510" width="10" height="1160" as="geometry" />
        </mxCell>
        <mxCell id="aipi_active" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="855" y="670" width="10" height="880" as="geometry" />
        </mxCell>
        <mxCell id="p1_bg" value="&lt;b style=&quot;font-size:13px; color:#37474f;&quot;&gt;PHASE 1 : ÉTABLISSEMENT DU CANAL SSE PERSISTANT &amp;amp; MÉCANISME DE KEEPALIVE (Console Platform ↔ Walspool)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#90a4ae;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="1640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="e1_1" value="&lt;b&gt;1.1. Inscription au flux de logs en direct : GET /api/v1/observability/logs/stream&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Headers: Accept: text/event-stream | Cache-Control: no-cache | (EventSource factory)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1550" y="225" as="sourcePoint" />
            <mxPoint x="510" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1_2" value="&lt;b&gt;1.2. Relais proxy SSE : GET /v1/logs/stream&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Proxy Node.js non-bufferisé (ObservabilityController.getLogsStream)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="265" as="sourcePoint" />
            <mxPoint x="1210" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1_3a" value="&lt;b&gt;1.3. Headers HTTP 200 + Flush immédiat + Événement initial : &lt;font color=&quot;#2e7d32&quot;&gt;&quot;: connected\n\n&quot;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Headers: Content-Type: text/event-stream | X-Accel-Buffering: no | Connection: keep-alive&lt;/font&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="310" as="sourcePoint" />
            <mxPoint x="510" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1_3b" value="&lt;b&gt;1.3 (suite). Relais direct (upstreamRes.pipe(res)) ➔ Console connectée&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="310" as="sourcePoint" />
            <mxPoint x="1550" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1_4a" value="&lt;b&gt;1.4. Heartbeat périodique (ticker Go 10s) : &lt;font color=&quot;#d79b00&quot;&gt;&quot;: keepalive\n\n&quot;&lt;/font&gt;&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="355" as="sourcePoint" />
            <mxPoint x="510" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1_4b" value="&lt;b&gt;Keepalive relayé vers Console (maintien connexion TCP active)&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#10739e;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="355" as="sourcePoint" />
            <mxPoint x="1550" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n1" value="&lt;b style=&quot;color:#bf360c;&quot;&gt;Contrat de Résilience SSE &amp;amp; Anti-Buffering :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;X-Accel-Buffering: no&lt;/b&gt; interdit aux proxies intermédiaires (NGINX, Envoy, Traefik) d'accumuler les buffers de streaming.&lt;br&gt;• Le ticker interne Walspool émet un commentaire SSE &lt;i&gt;(&quot;: keepalive\n\n&quot;)&lt;/i&gt; toutes les 10s, empêchant les timeouts de passerelle.&lt;br&gt;• En cas de coupure réseau, le store Vue 3 reconnecte automatiquement le flux avec backoff exponentiel &amp;amp; background sync." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#fff8e1;strokeColor=#ffe082;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="380" width="790" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_bg" value="&lt;b style=&quot;font-size:13px; color:#4a148c;&quot;&gt;PHASE 2 : INGESTION MÉTIER &amp;amp; PROPAGATION UNIFIÉE DU CONTEXTE (AsyncLocalStorage ↔ contextvars)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf7ff;strokeColor=#ba68c8;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1640" height="440" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;2. Requête Métier : POST /api/v1/ai/generate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Payload: {&quot;prompt&quot;: &quot;Analyser les données de télémétrie du cluster...&quot;} (aucun x-request-id présent)&lt;/font&gt;" style="endArrow=block;html=1;strokeColor=#1e88e5;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="515" as="sourcePoint" />
            <mxPoint x="505" y="515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e3_loop" value="&lt;b&gt;3. TraceMiddleware (LoopBack 4)&lt;/b&gt;&lt;br&gt;Vérifie / génère UUID v4&lt;br&gt;Initialise AsyncLocalStorage" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="535" as="sourcePoint" />
            <mxPoint x="515" y="605" as="targetPoint" />
            <Array as="points">
              <mxPoint x="590" y="535" />
              <mxPoint x="590" y="605" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n3" value="&lt;b style=&quot;color:#4a148c;&quot;&gt;Détails Interception TraceMiddleware (Node.js) :&lt;/b&gt;&lt;br&gt;1. Recherche en-têtes : &lt;i&gt;x-request-id&lt;/i&gt;, &lt;i&gt;x-correlation-id&lt;/i&gt;, &lt;i&gt;x-trace-id&lt;/i&gt;.&lt;br&gt;2. Génère un UUID v4 unique : &lt;b style=&quot;color:#1e88e5;&quot;&gt;trace_id = &quot;c4a2e881-3b71-48f9-902e-1d5e3170a821&quot;&lt;/b&gt;.&lt;br&gt;3. Injection précoce dans la réponse : &lt;i&gt;res.setHeader('x-request-id', traceId)&lt;/i&gt;.&lt;br&gt;4. Exécute la chaîne d'intercepteurs dans &lt;b&gt;traceStorage.run({ traceId, startTime: Date.now(), ... })&lt;/b&gt; via &lt;b&gt;AsyncLocalStorage&lt;/b&gt; (isolation totale sans variables globales).&lt;br&gt;5. Mémorise &lt;i&gt;startTime&lt;/i&gt; pour le calcul de durée aval." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#f3e5f5;strokeColor=#ce93d8;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="540" width="265" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="&lt;b style=&quot;font-size:12px;&quot;&gt;4. Propagation HTTP vers service aval : POST http://aipi:8000/api/v1/inference&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1e88e5&quot;&gt;&lt;b&gt;Headers injectés: [x-request-id: c4a2e881-3b71-48f9-902e-1d5e3170a821]&lt;/b&gt;&lt;/font&gt; | Content-Type: application/json" style="endArrow=block;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="685" as="sourcePoint" />
            <mxPoint x="855" y="685" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e5_loop" value="&lt;b&gt;5. TraceMiddleware Django&lt;/b&gt;&lt;br&gt;Extrait header x-request-id&lt;br&gt;Stocke dans contextvars" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="705" as="sourcePoint" />
            <mxPoint x="865" y="775" as="targetPoint" />
            <Array as="points">
              <mxPoint x="945" y="705" />
              <mxPoint x="945" y="775" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n5" value="&lt;b style=&quot;color:#2e7d32;&quot;&gt;Détails Middleware AIPI (Python / Django) :&lt;/b&gt;&lt;br&gt;1. Récupère l'en-tête &lt;i&gt;request.headers.get('x-request-id')&lt;/i&gt;.&lt;br&gt;2. Initialise la variable de contexte thread-safe / async-safe :&lt;br&gt;   &lt;b&gt;token = request_trace_id.set(trace_id)&lt;/b&gt; (&lt;i&gt;ContextVar[Optional[str]]&lt;/i&gt;).&lt;br&gt;3. Associe &lt;i&gt;request.trace_id = trace_id&lt;/i&gt; pour l'accès direct dans les vues.&lt;br&gt;4. Bloc strict &lt;b&gt;finally: reset_current_trace_id(token)&lt;/b&gt; garantissant l'absence totale de fuite de contexte entre requêtes réutilisant le même thread WSGI/ASGI." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#e8f5e9;strokeColor=#a5d6a7;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="710" width="370" height="135" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;✔ Garantie Corrélation Distribuée :&lt;/b&gt; Le Trace ID &lt;b style=&quot;color:#1e88e5;&quot;&gt;c4a2e881-3b71-48f9-902e-1d5e3170a821&lt;/b&gt; est désormais lié de manière transparente et asynchrone aux contextes d'exécution Node.js (V8) et Python (CPython), prêt pour toute journalisation sans passage explicite de paramètres." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a148c;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="855" width="1280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_bg" value="&lt;b style=&quot;font-size:13px; color:#1b5e20;&quot;&gt;PHASE 3 : TÉLÉMÉTRIE ASYNCHRONE NON-BLOQUANTE &amp;amp; DIFFUSION TEMPS RÉEL (AIPI ➔ Walspool ➔ Vue 3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#81c784;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1640" height="520" as="geometry" />
        </mxCell>
        <mxCell id="e6_1" value="&lt;b&gt;6.1. Exécution Inférence : logger.info(&quot;Démarrage inférence IA&quot;, extra={&quot;model&quot;: &quot;llama-3-8b&quot;, &quot;tokens&quot;: 512})&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="965" as="sourcePoint" />
            <mxPoint x="865" y="1015" as="targetPoint" />
            <Array as="points">
              <mxPoint x="930" y="965" />
              <mxPoint x="930" y="1015" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n6" value="&lt;b style=&quot;color:#e65100;&quot;&gt;6.2. WalspoolHandler.emit() (Arrière-plan Non-Bloquant) :&lt;/b&gt;&lt;br&gt;• Récupère automatiquement le &lt;b&gt;trace_id&lt;/b&gt; actif via &lt;i&gt;get_current_trace_id()&lt;/i&gt; depuis &lt;i&gt;contextvars&lt;/i&gt;.&lt;br&gt;• Formate le payload selon le schéma &lt;b&gt;StandardLogEvent&lt;/b&gt; (timestamp ISO UTC, service: &quot;aipi&quot;, context, extra).&lt;br&gt;• Enfile l'événement sans attendre : &lt;b&gt;_queue.put_nowait(event)&lt;/b&gt; (file bornée max 5000 items).&lt;br&gt;• &lt;b&gt;Isolation Black-Box :&lt;/b&gt; Le thread de calcul IA n'attend JAMAIS le réseau. Si Walspool est éteint ou saturé, le log est droppé sans lever d'exception métier." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#fff3e0;strokeColor=#ffb74d;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="990" width="395" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e6_3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;6.3. Thread Daemon (WalspoolLogWorker) : POST http://localhost:9099/v1/enqueue&lt;/b&gt;&lt;br&gt;Payload: {&quot;topic&quot;: &quot;pilot4it.aipi.logs&quot;, &quot;payload&quot;: { &quot;service&quot;: &quot;aipi&quot;, &quot;trace_id&quot;: &quot;c4a2e881...&quot;, &quot;level&quot;: &quot;INFO&quot;, &quot;message&quot;: &quot;Démarrage inférence IA&quot; }}" style="endArrow=block;html=1;strokeColor=#e65100;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="1080" as="sourcePoint" />
            <mxPoint x="1210" y="1080" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e6_4" value="&lt;b&gt;6.4. HTTP 202 Accepted {&quot;status&quot;: &quot;accepted&quot;, &quot;topic&quot;: &quot;pilot4it.aipi.logs&quot;, &quot;size_bytes&quot;: 312}&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#e65100;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="1115" as="sourcePoint" />
            <mxPoint x="865" y="1115" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7_loop" value="&lt;b&gt;7.1. Moteur Walspool (Go)&lt;/b&gt;&lt;br&gt;• Append WAL disque (fsync &amp;amp; CRC32)&lt;br&gt;• Index circulaire MemoryLogHub&lt;br&gt;• Broadcast immédiat canal logCh" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1215" y="1135" as="sourcePoint" />
            <mxPoint x="1215" y="1205" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1300" y="1135" />
              <mxPoint x="1300" y="1205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7_push_gw" value="&lt;b style=&quot;font-size:12px;&quot;&gt;7.2. Push SSE temps réel (Flux actif) : data: {&quot;timestamp&quot;:&quot;...&quot;,&quot;service&quot;:&quot;aipi&quot;,&quot;trace_id&quot;:&quot;c4a2e881...&quot;,&quot;level&quot;:&quot;INFO&quot;,&quot;message&quot;:&quot;Démarrage inférence IA&quot;}\n\n&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#0288d1;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="1225" as="sourcePoint" />
            <mxPoint x="510" y="1225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e7_push_ui" value="&lt;b&gt;Relais SSE immédiat vers Console Platform&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#0288d1;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="1225" as="sourcePoint" />
            <mxPoint x="1550" y="1225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e8_loop" value="&lt;b&gt;8. Réception Vue 3 &amp;amp; Pinia Store&lt;/b&gt;&lt;br&gt;onmessage ➔ normalizeLogEvent()&lt;br&gt;addLog() ➔ logs.value réactif" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1555" y="1245" as="sourcePoint" />
            <mxPoint x="1555" y="1315" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1625" y="1245" />
              <mxPoint x="1625" y="1315" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n8" value="&lt;b style=&quot;color:#0277bd;&quot;&gt;Détails Normalisation &amp;amp; Réactivité Vue 3 (useObservabilityStore) :&lt;/b&gt;&lt;br&gt;• &lt;b&gt;normalizeLogEvent(raw) :&lt;/b&gt; Uniformise les champs hétérogènes (timestamp UTC, level normalisé en minuscule, ID unique déterministe ou aléatoire, extraction payload/extra).&lt;br&gt;• &lt;b&gt;addLog(log) :&lt;/b&gt; Dédoublonne par &lt;i&gt;log.id&lt;/i&gt;, respecte le buffer tournant &lt;i&gt;maxBufferSize&lt;/i&gt; (500 logs) et déclenche la réactivité Pinia / Vue 3.&lt;br&gt;• &lt;b&gt;Affichage direct :&lt;/b&gt; L'événement AIPI apparaît en temps réel dans le tableau sans rafraîchissement ni polling !" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=middle;align=left;fillColor=#e1f5fe;strokeColor=#81d4fa;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1170" y="1325" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4_bg" value="&lt;b style=&quot;font-size:13px; color:#006064;&quot;&gt;PHASE 4 : COMPLÉTION DE L'INFÉRENCE, CALCUL DE LATENCE &amp;amp; CORRÉLATION WATERFALL GANTT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=#4dd0e1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1470" width="1640" height="780" as="geometry" />
        </mxCell>
        <mxCell id="e9_1" value="&lt;b&gt;9.1. Inférence IA terminée (185ms)&lt;/b&gt;&lt;br&gt;finally: reset_current_trace_id(token)&lt;br&gt;Injection header réponse: x-request-id" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="865" y="1490" as="sourcePoint" />
            <mxPoint x="865" y="1540" as="targetPoint" />
            <Array as="points">
              <mxPoint x="930" y="1490" />
              <mxPoint x="930" y="1540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9_2" value="&lt;b style=&quot;font-size:12px;&quot;&gt;9.2. Réponse microservice aval : HTTP/1.1 200 OK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1e88e5&quot;&gt;&lt;b&gt;Headers: [x-request-id: c4a2e881-3b71-48f9-902e-1d5e3170a821]&lt;/b&gt;&lt;/font&gt; | Body: {&quot;status&quot;: &quot;success&quot;, &quot;tokens_generated&quot;: 142, &quot;inference_ms&quot;: 185}" style="endArrow=block;dashed=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="855" y="1550" as="sourcePoint" />
            <mxPoint x="515" y="1550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e9_3" value="&lt;b style=&quot;font-size:12px;&quot;&gt;9.3. Réponse finale au client : HTTP/1.1 200 OK&lt;/b&gt;&lt;br&gt;Headers: [x-request-id: c4a2e881-3b71-48f9-902e-1d5e3170a821] | Body: {&quot;result&quot;: &quot;Analyse complétée avec succès...&quot;}" style="endArrow=block;dashed=1;html=1;strokeColor=#1e88e5;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="1585" as="sourcePoint" />
            <mxPoint x="180" y="1585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e10_calc" value="&lt;b&gt;10.1. TraceMiddleware fin de cycle&lt;/b&gt;&lt;br&gt;durationMs = Date.now() - startTime = &lt;b style=&quot;color:#d81b60;&quot;&gt;210ms&lt;/b&gt;&lt;br&gt;GatewayLogger.logRequest() (non-blocking)" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="1605" as="sourcePoint" />
            <mxPoint x="515" y="1660" as="targetPoint" />
            <Array as="points">
              <mxPoint x="590" y="1605" />
              <mxPoint x="590" y="1660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10_enqueue" value="&lt;b style=&quot;font-size:12px;&quot;&gt;10.2. Émission log Gateway : POST http://localhost:9099/v1/enqueue&lt;/b&gt;&lt;br&gt;Payload: {&quot;topic&quot;: &quot;pilot4it.gateway.logs&quot;, &quot;payload&quot;: { &quot;service&quot;: &quot;api-gateway&quot;, &quot;trace_id&quot;: &quot;c4a2e881...&quot;, &quot;duration_ms&quot;: 210, &quot;status_code&quot;: 200, &quot;method&quot;: &quot;POST&quot;, &quot;path&quot;: &quot;/api/v1/ai/generate&quot; }}" style="endArrow=block;html=1;strokeColor=#6a1b9a;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="515" y="1670" as="sourcePoint" />
            <mxPoint x="1210" y="1670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e10_ack" value="&lt;b&gt;10.3. HTTP 202 Accepted&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#6a1b9a;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="1705" as="sourcePoint" />
            <mxPoint x="515" y="1705" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e11_push_gw" value="&lt;b style=&quot;font-size:12px;&quot;&gt;11. Push SSE log Gateway : data: {&quot;timestamp&quot;:&quot;...&quot;,&quot;service&quot;:&quot;api-gateway&quot;,&quot;trace_id&quot;:&quot;c4a2e881...&quot;,&quot;duration_ms&quot;:210,&quot;status_code&quot;:200,&quot;message&quot;:&quot;POST /api/v1/ai/generate 200 (210ms)&quot;}\n\n&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#0288d1;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1210" y="1745" as="sourcePoint" />
            <mxPoint x="510" y="1745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e11_push_ui" value="&lt;b&gt;Relais SSE immédiat vers Console Platform&lt;/b&gt;" style="endArrow=block;dashed=1;html=1;strokeColor=#0288d1;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="1745" as="sourcePoint" />
            <mxPoint x="1550" y="1745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e12_loop" value="&lt;b&gt;12.1. Agrégation &amp;amp; Synthèse Trace&lt;/b&gt;&lt;br&gt;activeTraceSummary déclenche&lt;br&gt;&lt;b&gt;computeTraceSummary(traceLogs)&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;endArrow=block;html=1;strokeColor=#10739e;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1555" y="1765" as="sourcePoint" />
            <mxPoint x="1555" y="1835" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1635" y="1765" />
              <mxPoint x="1635" y="1835" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="wf_card" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00838f;strokeWidth=2.5;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="1860" width="1440" height="360" as="geometry" />
        </mxCell>
        <mxCell id="wf_title" value="&lt;b style=&quot;font-size:14px; color:#006064;&quot;&gt;ÉTAPE 12.2 : VUE CASCADE DE TRACE (GANTT WATERFALL) RECONSTITUÉE DANS LA CONSOLE PLATFORM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#37474f&quot;&gt;Trace ID : &lt;b style=&quot;color:#1e88e5;&quot;&gt;c4a2e881-3b71-48f9-902e-1d5e3170a821&lt;/b&gt; | Durée totale : &lt;b style=&quot;color:#d81b60;&quot;&gt;210 ms&lt;/b&gt; | Nombre de Spans : &lt;b&gt;2&lt;/b&gt; | Statut global : &lt;b style=&quot;color:#2e7d32;&quot;&gt;200 OK (Succès)&lt;/b&gt; | Calcul : &lt;i&gt;computeTraceSummary()&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e0f7fa;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="225" y="1865" width="1430" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wf_axis" value="&lt;font color=&quot;#546e7a&quot;&gt;&lt;b&gt;T0 (0ms)&lt;/b&gt; ────────────────── &lt;b&gt;T+50ms&lt;/b&gt; ────────────────── &lt;b&gt;T+100ms&lt;/b&gt; ────────────────── &lt;b&gt;T+150ms&lt;/b&gt; ────────────────── &lt;b&gt;T+200ms&lt;/b&gt; ─── &lt;b&gt;T+210ms&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="1915" width="1120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s1_lbl" value="&lt;b style=&quot;color:#4a148c;&quot;&gt;Span 1 (Parent Root)&lt;/b&gt;&lt;br&gt;&lt;b&gt;api-gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;POST /api/v1/ai/generate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#ab47bc;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="1945" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s1_bar" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;api-gateway : POST /api/v1/ai/generate — 200 OK — Durée: 210 ms (100% de la trace)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e24aa;strokeColor=#4a148c;align=center;verticalAlign=middle;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="1945" width="1120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s2_lbl" value="&lt;b style=&quot;color:#1b5e20;&quot;&gt;Span 2 (Child Span)&lt;/b&gt;&lt;br&gt;&lt;b&gt;aipi&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;POST /api/v1/inference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66bb6a;align=left;verticalAlign=middle;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="2005" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s2_bar" value="&lt;b style=&quot;color:#ffffff;&quot;&gt;aipi : Inférence IA (Llama-3-8b, 142 tokens) — Durée: 185 ms (88.1% de la trace)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2e7d32;strokeColor=#1b5e20;align=center;verticalAlign=middle;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="2005" width="986" height="45" as="geometry" />
        </mxCell>
        <mxCell id="wf_table" value="&lt;table style=&quot;width:100%; border-collapse:collapse; font-size:11px;&quot;&gt;       &lt;tr style=&quot;background-color:#eceff1;&quot;&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:left;&quot;&gt;Service&lt;/th&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:left;&quot;&gt;Méthode / Endpoint&lt;/th&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:center;&quot;&gt;Statut&lt;/th&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;Début Relatif&lt;/th&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;Durée (ms)&lt;/th&gt;         &lt;th style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:left;&quot;&gt;Contexte Métier &amp;amp; Corrélation&lt;/th&gt;       &lt;/tr&gt;       &lt;tr style=&quot;background-color:#ffffff;&quot;&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;&lt;b style=&quot;color:#8e24aa;&quot;&gt;api-gateway&lt;/b&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;POST /api/v1/ai/generate&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:center;&quot;&gt;&lt;span style=&quot;background-color:#e8f5e9; color:#2e7d32; font-weight:bold; padding:2px 6px; border-radius:3px;&quot;&gt;200 OK&lt;/span&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;+0.0 ms&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;&lt;b&gt;210 ms&lt;/b&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;Trace root • AsyncLocalStorage context • Latence overhead Gateway/Réseau: 25ms (11.9%)&lt;/td&gt;       &lt;/tr&gt;       &lt;tr style=&quot;background-color:#fafafa;&quot;&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;&lt;b style=&quot;color:#2e7d32;&quot;&gt;aipi&lt;/b&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;POST /api/v1/inference&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:center;&quot;&gt;&lt;span style=&quot;background-color:#e8f5e9; color:#2e7d32; font-weight:bold; padding:2px 6px; border-radius:3px;&quot;&gt;200 OK&lt;/span&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;+15.0 ms&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc; text-align:right;&quot;&gt;&lt;b&gt;185 ms&lt;/b&gt;&lt;/td&gt;         &lt;td style=&quot;padding:5px; border:1px solid #cfd8dc;&quot;&gt;Child span • contextvars propagation • Llama-3-8b (prompt: 512 tokens, gen: 142 tokens)&lt;/td&gt;       &lt;/tr&gt;     &lt;/table&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="2060" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sum_bg" value="&lt;b style=&quot;font-size:13px; color:#263238;&quot;&gt;SYNTHÈSE ARCHITECTURALE : PRINCIPES BLACK-BOX, PERFORMANCE &amp;amp; TRAÇABILITÉ DISTRIBUÉE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=15;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="2270" width="1640" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pil_1" value="&lt;b style=&quot;color:#1e88e5; font-size:12px;&quot;&gt;1. Corrélation de Bout en Bout&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;x-request-id unique :&lt;/b&gt; Résolu à l'entrée Gateway ou généré en UUID v4 immuable.&lt;br&gt;• &lt;b&gt;Propagation inter-services :&lt;/b&gt; Transmis via les headers HTTP standards vers tous les microservices avals.&lt;br&gt;• &lt;b&gt;Isolation contextuelle :&lt;/b&gt; &lt;i&gt;AsyncLocalStorage&lt;/i&gt; (Node.js) et &lt;i&gt;contextvars&lt;/i&gt; (Python) évitent tout passage manuel du trace_id dans le code métier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="2310" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="pil_2" value="&lt;b style=&quot;color:#2e7d32; font-size:12px;&quot;&gt;2. Isolation Black-Box &amp;amp; Résilience&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Zéro blocage métier :&lt;/b&gt; Les handlers de journalisation (&lt;i&gt;WalspoolHandler&lt;/i&gt;) délèguent à des files en mémoire bornées (5000 items) et des workers daemon.&lt;br&gt;• &lt;b&gt;Tolérance aux pannes :&lt;/b&gt; Si Walspool est éteint ou inaccessible, les logs sont ignorés silencieusement sans perturber le client final.&lt;br&gt;• &lt;b&gt;Nettoyage garanti :&lt;/b&gt; Blocs &lt;i&gt;finally&lt;/i&gt; systématiques pour réinitialiser les ContextVar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="2310" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="pil_3" value="&lt;b style=&quot;color:#e65100; font-size:12px;&quot;&gt;3. Streaming SSE &amp;amp; Anti-Buffering&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Diffusion sans latence :&lt;/b&gt; Walspool écrit sur disque WAL et notifie immédiatement ses abonnés SSE via channel Go.&lt;br&gt;• &lt;b&gt;Contournement des proxys :&lt;/b&gt; Header &lt;i&gt;X-Accel-Buffering: no&lt;/i&gt; et stream direct Node.js (&lt;i&gt;upstreamRes.pipe(res)&lt;/i&gt;).&lt;br&gt;• &lt;b&gt;Maintien TCP permanent :&lt;/b&gt; Ticker périodique de 10s émettant des commentaires &lt;i&gt;: keepalive\n\n&lt;/i&gt; anti-timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="2310" width="380" height="185" as="geometry" />
        </mxCell>
        <mxCell id="pil_4" value="&lt;b style=&quot;color:#00838f; font-size:12px;&quot;&gt;4. Console Réactive &amp;amp; Waterfall&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Normalisation unifiée :&lt;/b&gt; &lt;i&gt;normalizeLogEvent()&lt;/i&gt; réconcilie les formats polyglottes (LoopBack 4, Django, Go) en schéma &lt;i&gt;StandardLogEvent&lt;/i&gt;.&lt;br&gt;• &lt;b&gt;Réactivité Pinia / Vue 3 :&lt;/b&gt; Ingestion directe dans le buffer réactif &lt;i&gt;logs.value&lt;/i&gt; plafonné.&lt;br&gt;• &lt;b&gt;Reconstitution Gantt :&lt;/b&gt; &lt;i&gt;computeTraceSummary()&lt;/i&gt; calcule les offsets temporels et génère la cascade multi-spans." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;strokeWidth=1.5;align=left;verticalAlign=top;spacing=10;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="2310" width="370" height="185" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_7_go_and_docker" name="Page 7 - Pourquoi Go &amp; Integration Docker Microservices">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_banner" parent="1" value="&amp;lt;b style='font-size:22px; color:#38bdf8;'&amp;gt;POURQUOI GO ? &amp;amp; IMPLÉMENTATION MICROSERVICES DOCKER&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='font-size:13px; color:#94a3b8;'&amp;gt;Analyse des choix technologiques, matrice des compromis et architecture conteneurisée de production&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;strokeWidth=2;align=center;" vertex="1">
          <mxGeometry x="40" y="30" width="1620" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sec1_box" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#3b82f6;strokeWidth=2;dashed=0;" vertex="1">
          <mxGeometry x="40" y="120" width="790" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sec1_title" parent="1" value="&amp;lt;b style='font-size:16px; color:#60a5fa;'&amp;gt;1. POURQUOI CHOISIR GO POUR WALSPOOL ?&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='font-size:11px; color:#94a3b8;'&amp;gt;Justification technique, performances I/O et matrice des compromis&amp;lt;/span&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1">
          <mxGeometry x="60" y="135" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="go_challenge" parent="1" value="&amp;lt;b style='color:#f87171;'&amp;gt;LE DÉFI SYSTÈME :&amp;lt;/b&amp;gt; Ingestion continue à &amp;amp;lt; 50µs, buffer circulaire de 50 000 logs sans fuite RAM, diffusion SSE concurrente vers des dizaines de navigateurs et écriture disque sans jamais bloquer l'appelant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#475569;fontColor=#e2e8f0;fontSize=11;align=left;spacing=10;" vertex="1">
          <mxGeometry x="60" y="185" width="750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="go_pros_title" parent="1" value="&amp;lt;b style='color:#34d399; font-size:13px;'&amp;gt;✔ AVANTAGES MAJEURS DE GO&amp;lt;/b&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1">
          <mxGeometry x="60" y="245" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pro_0" parent="1" value="&amp;lt;b style='color:#10b981; font-size:12px;'&amp;gt;Binaire Statique Autonome (~15 Mo)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Zéro dépendance système, pas besoin de JVM, ni d'interpréteur Python, ni de Node.js sur l'hôte. Démarrage instantané (&amp;amp;lt; 10ms).&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="275" width="750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pro_1" parent="1" value="&amp;lt;b style='color:#10b981; font-size:12px;'&amp;gt;Concurrence Ultra-Légère (Goroutines 2 Ko)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;10 000 connexions SSE simultanées consomment ~20 Mo de RAM, contre plusieurs Go avec les threads système de Java ou C++.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="355" width="750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pro_2" parent="1" value="&amp;lt;b style='color:#10b981; font-size:12px;'&amp;gt;Latence &amp;amp; GC Prédictibles (&amp;amp;lt; 1ms pause)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Le ramasse-miettes tricolore de Go évite les gels de l'Event Loop (problème récurrent de Node.js) et les pauses Stop-The-World de Java.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="435" width="750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pro_3" parent="1" value="&amp;lt;b style='color:#10b981; font-size:12px;'&amp;gt;I/O Système &amp;amp; Écritures Séquentielles Directes&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Accès natif à syscall et os.File. Écriture Append-Only ultra-rapide sur NVMe sans surcouche logicielle.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="515" width="750" height="65" as="geometry" />
        </mxCell>
        <mxCell id="go_cons_title" parent="1" value="&amp;lt;b style='color:#fbbf24; font-size:13px;'&amp;gt;⚠ COMPROMIS ET INCONVÉNIENTS ASSUMÉS&amp;lt;/b&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1">
          <mxGeometry x="60" y="595" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="con_0" parent="1" value="&amp;lt;b style='color:#f59e0b; font-size:12px;'&amp;gt;Barrière de Compétence Équipe (Stack Python/TypeScript)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;L'équipe interne maîtrise Python (Django) et TypeScript (Vue/Node). Contribuer au moteur interne demande des notions de Go. &amp;lt;b style='color:#38bdf8;'&amp;gt;Atténuation Black-Box :&amp;lt;/b&amp;gt; Les microservices ne voient que des requêtes HTTP standard.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="625" width="750" height="70" as="geometry" />
        </mxCell>
        <mxCell id="con_1" parent="1" value="&amp;lt;b style='color:#f59e0b; font-size:12px;'&amp;gt;Verbosité de la Gestion d'Erreurs (if err != nil)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Absence d'exceptions magiques : chaque I/O et parsing doit être traité explicitement. Rend le code plus robuste mais plus long à écrire.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="715" width="750" height="70" as="geometry" />
        </mxCell>
        <mxCell id="con_2" parent="1" value="&amp;lt;b style='color:#f59e0b; font-size:12px;'&amp;gt;Pas de 'Zero-Cost' Absolu (Présence d'un GC)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Contrairement à Rust ou C++, Go a un ramasse-miettes. Mais dans Walspool, le Ring Buffer à taille fixe réutilise la mémoire en O(1), ce qui réduit la pression sur le GC à quasi zéro.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="60" y="795" width="750" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sec2_box" parent="1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#10b981;strokeWidth=2;dashed=0;" vertex="1">
          <mxGeometry x="870" y="120" width="790" height="800" as="geometry" />
        </mxCell>
        <mxCell id="sec2_title" parent="1" value="&amp;lt;b style='font-size:16px; color:#34d399;'&amp;gt;2. IMPLÉMENTATION MICROSERVICES AVEC DOCKER&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='font-size:11px; color:#94a3b8;'&amp;gt;Topologie de déploiement, réseau bridge, résilience et proxying&amp;lt;/span&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1">
          <mxGeometry x="890" y="135" width="750" height="40" as="geometry" />
        </mxCell>
        <mxCell id="topo_title" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:13px;'&amp;gt;TOPOLOGIES DE DÉPLOIEMENT POSSIBLES&amp;lt;/b&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1">
          <mxGeometry x="890" y="185" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="topo_0" parent="1" value="&amp;lt;b style='color:#ffffff; font-size:12px;'&amp;gt;A. Démon sur Machine Hôte (Configuration Actuelle Dev)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Walspool tourne directement sur l'hôte Linux (:9099). Les conteneurs Docker (172.99.0.0/24) le joignent via la passerelle par défaut 172.99.0.1:9099. Performance I/O maximale sans overhead de virtualisation de volume.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0284c7;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="215" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="topo_1" parent="1" value="&amp;lt;b style='color:#ffffff; font-size:12px;'&amp;gt;B. Service Dédié Docker Compose (Recommandé Staging/Prod)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Walspool conteneurisé dans docker-compose.yml (image scratch ou alpine ~18Mo). Volume persistant ./data/spool:/data/spool. Joint par son nom de service http://walspool:9099 sur le réseau bridge interne.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="305" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="topo_2" parent="1" value="&amp;lt;b style='color:#ffffff; font-size:12px;'&amp;gt;C. Sidecar Pattern par Pod (Kubernetes)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Un conteneur Walspool accompagne chaque pod de microservice. Communication ultra-sécurisée via localhost:9099 avec volume emptyDir ou PersistentVolumeClaim.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b0764;strokeColor=#a855f7;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="395" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pillars_title" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:13px;'&amp;gt;LES 4 PILIERS DE L'INTÉGRATION EN PRODUCTION&amp;lt;/b&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;" vertex="1">
          <mxGeometry x="890" y="485" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="pillar_0" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:12px;'&amp;gt;1. Découplage Black-Box Universel (Polyglot)&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Tout microservice (Node.js, Django, Java, Rust) émet ses logs via un simple HTTP POST /v1/enqueue. Pas de SDK lourd ni de pilote propriétaire obligatoire.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="515" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pillar_1" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:12px;'&amp;gt;2. Failsafe Non-Bloquant Côté Microservice&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;L'envoi se fait via un worker démon et une file bornée (ex: Queue de 5 000 logs). Si Walspool redémarre ou est temporairement éteint, AUCUN microservice ne crashe ni ne ralentit.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="605" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pillar_2" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:12px;'&amp;gt;3. Directives Nginx Anti-Buffering pour le Flux SSE&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Dans le reverse proxy Nginx : 'proxy_buffering off;' et 'add_header X-Accel-Buffering no;'. Permet d'éviter que Nginx ne retienne les logs par blocs de 4Ko.&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="695" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pillar_3" parent="1" value="&amp;lt;b style='color:#38bdf8; font-size:12px;'&amp;gt;4. Heartbeat Keepalive (10s) pour les Sockets Réseau&amp;lt;/b&amp;gt;&amp;lt;br/&amp;gt;&amp;lt;span style='color:#cbd5e1; font-size:11px;'&amp;gt;Walspool envoie automatiquement ': keepalive\n\n' toutes les 10s. Empêche la fermeture de socket par les pare-feux, ALB ou timeouts Nginx (proxy_read_timeout).&amp;lt;/span&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;strokeWidth=1;align=left;spacing=8;" vertex="1">
          <mxGeometry x="890" y="785" width="750" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ftr_banner" parent="1" value="&amp;lt;b style='color:#34d399;'&amp;gt;SYNTHÈSE ARCHITECTURALE :&amp;lt;/b&amp;gt; Le choix de Go assure l'extrême rapidité et l'empreinte mémoire minimale du moteur (&amp;amp;lt; 20Mo), tandis que l'architecture Black-Box et le contrat HTTP/SSE protègent l'équipe : chaque développeur continue de travailler dans son langage (Python/TypeScript) en toute indépendance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;strokeWidth=1;fontColor:#e2e8f0;fontSize=11;align=center;" vertex="1">
          <mxGeometry x="40" y="935" width="1620" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>