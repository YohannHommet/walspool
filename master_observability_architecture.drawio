        <mxCell id="banner_title" value="Ignimission Platform — Vue d'Ensemble de l'Architecture &amp;amp; Orchestration Conteneurs / Réseau" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#ffffff;verticalAlign=middle;align=left;spacingLeft=15;" vertex="1" parent="1">
