        <mxCell id="banner_sub" value="Pipeline Observabilité Temps Réel (SSE text/event-stream), Débuffering Nginx Reverse Proxy, API Gateway (LoopBack 4), Microservice IA (Django) &amp;amp; Démon Walspool Sidecar sur l'Hôte" style="text;html=1;fontSize=11;fontColor=#94a3b8;verticalAlign=middle;align=left;spacingLeft=15;" vertex="1" parent="1">
