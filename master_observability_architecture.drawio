        <mxCell id="badge_net" value="Docker Bridge : 172.99.0.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#475569;fontSize=10;fontColor=#38bdf8;fontStyle=1;align=center;arcSize=20;" vertex="1" parent="1">
